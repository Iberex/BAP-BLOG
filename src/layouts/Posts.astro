---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import { SITE } from "@config";
import { PIJLERS, bapWeek } from "@utils/pijlers";
import { slugifyStr } from "@utils/slugify";
import { SOORTEN } from "@utils/soorten";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { paginatedPosts } = Astro.props;

// Group posts per BAP week so the list reads as a timeline.
const weeks = new Map<number, CollectionEntry<"blog">[]>();
for (const post of paginatedPosts) {
  const week = bapWeek(new Date(post.data.pubDatetime));
  weeks.set(week, [...(weeks.get(week) ?? []), post]);
}

const soorten = [
  ...new Set(
    paginatedPosts.map(({ data }) => data.soort).filter(Boolean) as string[]
  ),
].sort();
---

<Layout title={`Posts | ${SITE.title}`}>
  <Header activeNav="posts" />
  <main id="main-content" class="page">
    <h2 class="page-title">Blog</h2>
    <div class="filters" aria-label="Filters">
      <a href={`${import.meta.env.BASE_URL}search/`} class="search-link">
        zoeken in alle posts →
      </a>
      <div class="filter-row" data-filter="soort">
        <span class="filter-label">Soort</span>
        <button class="chip" aria-pressed="true" data-value="">Alles</button>
        {
          soorten.map(soort => (
            <button
              class={`chip type-chip soort-${slugifyStr(soort)}`}
              aria-pressed="false"
              data-value={slugifyStr(soort)}
            >
              {SOORTEN[soort]?.label ?? soort}
            </button>
          ))
        }
      </div>
      <div class="filter-row" data-filter="pijler">
        <span class="filter-label">Pijler</span>
        <button class="chip" aria-pressed="true" data-value="">Alles</button>
        {
          PIJLERS.map(({ key, label }) => (
            <button class="chip" aria-pressed="false" data-value={key}>
              {label}
            </button>
          ))
        }
      </div>
    </div>

    {
      [...weeks].map(([week, posts]) => (
        <section class="week-group">
          <h3 class="week-label">
            {week >= 1 ? `week ${week}` : "voor de start"}
          </h3>
          <ul class="list">
            {posts.map(({ data, slug }) => (
              <Card
                href={`${import.meta.env.BASE_URL}posts/${slug}/`}
                frontmatter={data}
              />
            ))}
          </ul>
        </section>
      ))
    }
    <script
      id="pijler-labels"
      type="application/json"
      set:html={JSON.stringify(
        Object.fromEntries(PIJLERS.map(({ key, label }) => [key, label]))
      )}
    />
    <p id="no-results" hidden>Geen posts met deze filters.</p>
  </main>

  <Footer />
</Layout>

<style>
  .filters {
    @apply mb-12 flex flex-col gap-2 text-base;
  }
  .search-link {
    @apply mb-2 self-start text-sm opacity-60 hover:underline hover:underline-offset-4 hover:opacity-100;
  }
  .filter-row {
    @apply flex flex-wrap items-center gap-2;
  }
  .filter-label {
    @apply w-14 text-sm opacity-60;
  }
</style>

<script>
  // Filters live in the URL (?pijler=ux&soort=feedback) so a filtered view can be shared.
  const params = new URLSearchParams(location.search);
  if (params.has("soort") && params.has("pijler")) params.delete("pijler");
  const rows = document.querySelectorAll<HTMLElement>(".post-row");
  const groups = document.querySelectorAll<HTMLElement>(".week-group");

  const labels: Record<string, string> = JSON.parse(
    document.getElementById("pijler-labels")!.textContent!
  );

  function apply() {
    const pijler = params.get("pijler") ?? "";
    const soort = params.get("soort") ?? "";
    let shown = 0;

    rows.forEach(row => {
      const match =
        (!pijler || row.dataset.pijlers?.split(" ").includes(pijler)) &&
        (!soort || row.dataset.soort === soort);
      row.hidden = !match;
      const box = row.querySelector<HTMLElement>(".card__fragments");
      if (box) {
        let count = 0;
        box
          .querySelectorAll<HTMLElement>(".fragment:not(.card__summary)")
          .forEach(fragment => {
            const show =
              !!pijler && fragment.dataset.tags!.split(" ").includes(pijler);
            fragment.hidden = !show;
            if (show) count++;
          });
        const summary = box.querySelector<HTMLElement>(".card__summary");
        const useSummary = !!pijler && count === 0 && !!summary;
        if (summary) summary.hidden = !useSummary;
        box.hidden = !pijler || (count === 0 && !useSummary);
        const label = labels[pijler] ?? pijler;
        box.querySelector(".card__fragments-head")!.textContent = useSummary
          ? `Post over ${label}`
          : `${count} ${count === 1 ? "alinea" : "alinea's"} over ${label}`;
      }
      if (match) shown++;
    });
    groups.forEach(group => {
      group.hidden = !group.querySelector(".post-row:not([hidden])");
    });
    document.getElementById("no-results")!.hidden = shown > 0;

    document.querySelectorAll<HTMLElement>(".filter-row").forEach(filterRow => {
      const active = params.get(filterRow.dataset.filter!) ?? "";
      filterRow.querySelectorAll("button").forEach(button => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.value === active)
        );
      });
    });
  }

  document.querySelectorAll<HTMLElement>(".filter-row").forEach(filterRow => {
    filterRow.addEventListener("click", event => {
      const button = (event.target as HTMLElement).closest("button");
      if (!button) return;
      const value = button.dataset.value;
      params.delete("soort");
      params.delete("pijler");
      if (value) params.set(filterRow.dataset.filter!, value);
      const query = params.toString();
      history.replaceState(null, "", query ? `?${query}` : location.pathname);
      apply();
    });
  });

  apply();
</script>
