---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import { SITE } from "@config";
import { Icon } from "astro-icon/components";
import { PIJLERS, bapWeek } from "@utils/pijlers";
import { slugifyStr } from "@utils/slugify";
import { SOORTEN } from "@utils/soorten";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { paginatedPosts } = Astro.props;

// Group posts per BAP week so the list reads as a timeline.
const weeks = new Map<number, CollectionEntry<"blog">[]>();
for (const post of paginatedPosts) {
  const week = bapWeek(new Date(post.data.pubDatetime));
  weeks.set(week, [...(weeks.get(week) ?? []), post]);
}

const PIJLER_ICON: Record<string, string> = {
  ux: "lucide:layout-template",
  design: "lucide:palette",
  dev: "lucide:code-xml",
  ai: "lucide:sparkles",
};

const soorten = [
  ...new Set(paginatedPosts.flatMap(({ data }) => data.soorten)),
].sort();
---

<Layout title={`Posts | ${SITE.title}`}>
  <Header activeNav="posts" />
  <main id="main-content" class="page">
    <div class="page-head">
      <h2 class="page-title">Blog</h2>
      <a
        href="https://app.pagescms.org/iberex/BAP-BLOG"
        target="_blank"
        rel="noopener"
        class="btn btn--primary"><Icon name="lucide:plus" /> Nieuwe post</a
      >
    </div>
    <div class="filters" aria-label="Filters">
      <div class="fdrop filter-group" data-filter="soort" data-label="Soort">
        <button
          type="button"
          class="fbtn"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <Icon name="lucide:tag" />
          <span class="fbtn-text">Soort</span>
          <Icon name="lucide:chevron-down" class="fbtn-chevron" />
        </button>
        <div class="fmenu" role="listbox" hidden>
          <div class="fmenu-head">
            <span>Wat voor post?</span>
            <button type="button" class="fmenu-clear" data-value=""
              >Wissen</button
            >
          </div>
          {
            soorten.map(soort => (
              <button
                type="button"
                class="fopt"
                role="option"
                aria-pressed="false"
                data-value={slugifyStr(soort)}
                data-text={SOORTEN[soort]?.label ?? soort}
              >
                {SOORTEN[soort]?.label ?? soort}
                <Icon name="lucide:check" class="fopt-check" />
              </button>
            ))
          }
        </div>
      </div>
      <div
        class="fdrop filter-group"
        data-filter="pijler"
        data-label="Onderwerp"
      >
        <button
          type="button"
          class="fbtn"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <Icon name="lucide:layers" />
          <span class="fbtn-text">Onderwerp</span>
          <Icon name="lucide:chevron-down" class="fbtn-chevron" />
        </button>
        <div class="fmenu" role="listbox" hidden>
          <div class="fmenu-head">
            <span>Waarover?</span>
            <button type="button" class="fmenu-clear" data-value=""
              >Wissen</button
            >
          </div>
          {
            PIJLERS.map(({ key, label }) => (
              <button
                type="button"
                class="fopt"
                role="option"
                aria-pressed="false"
                data-value={key}
                data-text={label}
              >
                <Icon name={PIJLER_ICON[key]} class="fopt-icon" />
                {label}
                <Icon name="lucide:check" class="fopt-check" />
              </button>
            ))
          }
        </div>
      </div>
      <span class="filter-result" aria-live="polite">
        <span id="filter-count"></span>
        <button type="button" id="filter-reset" class="filter-reset" hidden>
          Alles wissen
        </button>
      </span>
    </div>

    {
      [...weeks].map(([week, posts]) => (
        <section class="week-group">
          <h3 class="week-label">
            {week >= 1 ? `week ${week}` : "voor de start"}
          </h3>
          <ul class="list">
            {posts.map(({ data, slug }) => (
              <Card
                href={`${import.meta.env.BASE_URL}posts/${slug}/`}
                frontmatter={data}
              />
            ))}
          </ul>
        </section>
      ))
    }
    <script
      id="pijler-labels"
      type="application/json"
      set:html={JSON.stringify(
        Object.fromEntries(PIJLERS.map(({ key, label }) => [key, label]))
      )}
    />
    <p id="no-results" hidden>Geen posts met deze filters.</p>
  </main>

  <Footer />
</Layout>

<script>
  // /posts/ and every post share one page file, so this script is bundled on
  // post pages too. Only run it where the post list is, or it crashes there
  // and stops the other scripts on the page (like the Mux video player).
  if (document.getElementById("pijler-labels")) {
    // Filters live in the URL (?pijler=ux&soort=feedback) so a filtered view can be shared.
    const params = new URLSearchParams(location.search);
    const rows = document.querySelectorAll<HTMLElement>(".post-row");
    const groups = document.querySelectorAll<HTMLElement>(".week-group");

    const labels: Record<string, string> = JSON.parse(
      document.getElementById("pijler-labels")!.textContent!
    );

    function apply() {
      const pijler = params.get("pijler") ?? "";
      const soort = params.get("soort") ?? "";
      let shown = 0;

      rows.forEach(row => {
        const match =
          (!pijler || row.dataset.pijlers?.split(" ").includes(pijler)) &&
          (!soort || row.dataset.soort?.split(" ").includes(soort));
        row.hidden = !match;
        const box = row.querySelector<HTMLElement>(".card__fragments");
        if (box) {
          let count = 0;
          box
            .querySelectorAll<HTMLElement>(".fragment:not(.card__summary)")
            .forEach(fragment => {
              const match =
                !!pijler && fragment.dataset.tags!.split(" ").includes(pijler);
              fragment.hidden = !match || count >= 2;
              if (match) count++;
            });
          const summary = box.querySelector<HTMLElement>(".card__summary");
          const useSummary = !!pijler && count === 0 && !!summary;
          if (summary) summary.hidden = !useSummary;
          box.hidden = !pijler || (count === 0 && !useSummary);
          const label = labels[pijler] ?? pijler;
          box.querySelector(".card__fragments-head")!.textContent = useSummary
            ? `Post over ${label}`
            : `${count} ${count === 1 ? "alinea" : "alinea's"} over ${label}`;
        }
        if (match) shown++;
      });
      groups.forEach(group => {
        group.hidden = !group.querySelector(".post-row:not([hidden])");
      });
      document.getElementById("no-results")!.hidden = shown > 0;
      document.getElementById("filter-count")!.textContent =
        pijler || soort ? `${shown} ${shown === 1 ? "post" : "posts"}` : "";
      document.getElementById("filter-reset")!.hidden = !pijler && !soort;

      document.querySelectorAll<HTMLElement>(".fdrop").forEach(drop => {
        const active = params.get(drop.dataset.filter!) ?? "";
        let text = "";
        drop.querySelectorAll<HTMLElement>(".fopt").forEach(option => {
          const on = option.dataset.value === active;
          option.setAttribute("aria-pressed", String(on));
          if (on) text = option.dataset.text ?? "";
        });
        drop.classList.toggle("is-active", !!active);
        drop.querySelector(".fbtn-text")!.textContent = active
          ? `${drop.dataset.label}: ${text}`
          : drop.dataset.label!;
      });
    }

    const drops = document.querySelectorAll<HTMLElement>(".fdrop");
    const closeAll = () =>
      drops.forEach(drop => {
        drop.querySelector<HTMLElement>(".fmenu")!.hidden = true;
        drop.querySelector(".fbtn")!.setAttribute("aria-expanded", "false");
      });
    document.addEventListener("click", event => {
      if (!(event.target as HTMLElement).closest(".fdrop")) closeAll();
    });
    document.addEventListener("keydown", event => {
      if (event.key === "Escape") closeAll();
    });

    drops.forEach(drop => {
      const menu = drop.querySelector<HTMLElement>(".fmenu")!;
      const toggle = drop.querySelector<HTMLElement>(".fbtn")!;
      toggle.addEventListener("click", () => {
        const open = menu.hidden;
        closeAll();
        menu.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
      });
      menu.addEventListener("click", event => {
        const button = (event.target as HTMLElement).closest<HTMLElement>(
          "button[data-value]"
        );
        if (!button) return;
        const value = button.dataset.value;
        // Each filter works on its own, so soort and pijler combine.
        const key = drop.dataset.filter!;
        params.delete(key);
        if (value) params.set(key, value);
        const query = params.toString();
        history.replaceState(null, "", query ? `?${query}` : location.pathname);
        apply();
        closeAll();
      });
    });

    document.getElementById("filter-reset")!.addEventListener("click", () => {
      params.delete("soort");
      params.delete("pijler");
      history.replaceState(null, "", location.pathname);
      apply();
    });

    apply();
  }
</script>
