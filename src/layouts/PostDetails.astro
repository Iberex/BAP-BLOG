---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PostExtras from "@components/PostExtras.astro";
import PostBody from "@components/blokken/PostBody.astro";
import PostHead from "@components/PostHead.astro";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import { SITE } from "@config";
import { Icon } from "astro-icon/components";

export interface Props {
  post: CollectionEntry<"blog">;
  prev?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
}

const { post, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  pijlers,
  soort,
  soorten,
} = post.data;

const { Content } = await post.render();
// Posts from "Posts (blokken)" in Pages CMS are built from blocks (src/components/blokken/).
const blokPost = (post.data.inhoud ?? []).length > 0;

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `${import.meta.env.BASE_URL}posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header />

  <main id="main-content" class="post">
    <p class="post-top">
      <a href={`${base}posts/`} class="btn"
        ><Icon name="lucide:arrow-left" /> Alle posts</a
      >
    </p>

    <div class="post-sheet">
      {
        blokPost ? (
          <PostBody data={post.data} />
        ) : (
          <PostHead
            title={title}
            author={author}
            soort={soort}
            soorten={soorten}
            date={pubDatetime}
            pijlers={pijlers}
            cover={post.data.beelden?.[0]?.src}
          />
        )
      }

      <div class="post-content">
        {!blokPost && <PostExtras data={post.data} />}
        {
          !blokPost && (
            <article id="article" role="article" class="prose max-w-none">
              <Content />
            </article>
          )
        }
      </div>
    </div>

    <nav class="post-buttons" aria-label="Andere posts">
      {
        next ? (
          <a href={`${base}posts/${next.slug}/`} class="post-nav">
            <span class="post-nav__label">
              <Icon name="lucide:arrow-left" /> Volgende post
            </span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        prev && (
          <a
            href={`${base}posts/${prev.slug}/`}
            class="post-nav post-nav--prev"
          >
            <span class="post-nav__label">
              Vorige post <Icon name="lucide:arrow-right" />
            </span>
            <strong>{prev.data.title}</strong>
          </a>
        )
      }
    </nav>
  </main>
  <Footer />
</Layout>

<script is:inline>
  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    let headings = Array.from(document.querySelectorAll("h2, h3, h4, h5, h6"));
    for (let heading of headings) {
      heading.classList.add("group");
      let link = document.createElement("a");
      link.innerText = "#";
      link.className = "heading-link hidden group-hover:inline-block ml-2";
      link.href = "#" + heading.id;
      link.ariaHidden = "true";
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    let copyButtonLabel = "Kopieer";
    let codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (let codeBlock of codeBlocks) {
      let wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      let copyButton = document.createElement("button");
      copyButton.className =
        "copy-code absolute right-3 -top-3 rounded bg-skin-card px-2 py-1 text-xs leading-4 text-skin-base font-medium";
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      let code = block.querySelector("code");
      let text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Gekopieerd";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();
</script>
