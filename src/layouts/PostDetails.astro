---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PostExtras from "@components/PostExtras.astro";
import Datetime from "@components/Datetime";
import { vimeoEmbed } from "@utils/vimeo";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import { pijlerLabel, bapWeek } from "@utils/pijlers";
import { SOORTEN } from "@utils/soorten";
import { SITE } from "@config";

export interface Props {
  post: CollectionEntry<"blog">;
  prev?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
}

const { post, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  pijlers,
  soort,
} = post.data;
const week = bapWeek(new Date(pubDatetime));
const vimeo = vimeoEmbed(post.data.video);

const { Content } = await post.render();

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `${import.meta.env.BASE_URL}posts/${slugifyStr(title)}.png`,
  Astro.url.origin
).href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header />

  <main id="main-content">
    <div class="post-top">
      <a href={`${base}posts/`} class="post-back plain">alle posts</a>
      {
        post.data.beelden[0] && (
          <img src={post.data.beelden[0].src!} alt="" class="post-image" />
        )
      }
      <h1 class="post-title">{title}</h1>
      <div class="post-date">
        <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} />
        <span>door {author}</span>
      </div>
      {
        post.data.samenvatting && (
          <p class="post-intro">{post.data.samenvatting}</p>
        )
      }
    </div>

    <div class="post-content">
      {
        vimeo && (
          <iframe
            src={vimeo}
            title={title}
            width="640"
            height="360"
            allow="fullscreen; picture-in-picture"
            allowfullscreen
          />
        )
      }
      <p class="mb-6 flex flex-wrap items-center gap-1.5">
        {
          soort && (
            <a
              href={`${base}posts/?soort=${slugifyStr(soort)}`}
              class={`type soort-${slugifyStr(soort)}`}
            >
              {SOORTEN[soort]?.label ?? soort}
            </a>
          )
        }
        {
          pijlers.map(p => (
            <a
              href={`${base}posts/?pijler=${slugifyStr(p)}`}
              class={`pill pill-${slugifyStr(p)}`}
            >
              {pijlerLabel(p)}
            </a>
          ))
        }
        {week >= 1 && <span class="ml-1 text-xs opacity-50">Week {week}</span>}
      </p>
      <PostExtras data={post.data} />
      <article id="article" role="article" class="prose max-w-none">
        <Content />
      </article>
    </div>

    <nav class="post-buttons" aria-label="Andere posts">
      {
        next ? (
          <a href={`${base}posts/${next.slug}/`}>← volgende post</a>
        ) : (
          <span />
        )
      }
      {prev && <a href={`${base}posts/${prev.slug}/`}>vorige post →</a>}
    </nav>
  </main>
  <Footer />
</Layout>

<script is:inline>
  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    let headings = Array.from(document.querySelectorAll("h2, h3, h4, h5, h6"));
    for (let heading of headings) {
      heading.classList.add("group");
      let link = document.createElement("a");
      link.innerText = "#";
      link.className = "heading-link hidden group-hover:inline-block ml-2";
      link.href = "#" + heading.id;
      link.ariaHidden = "true";
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    let copyButtonLabel = "Kopieer";
    let codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (let codeBlock of codeBlocks) {
      let wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      let copyButton = document.createElement("button");
      copyButton.className =
        "copy-code absolute right-3 -top-3 rounded bg-skin-card px-2 py-1 text-xs leading-4 text-skin-base font-medium";
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      let code = block.querySelector("code");
      let text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Gekopieerd";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();
</script>
