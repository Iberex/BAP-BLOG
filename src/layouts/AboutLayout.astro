---
import { SITE } from "@config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
    nav?: "about" | "planning" | "team";
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header activeNav={frontmatter.nav ?? "about"} />
  <main id="main-content" class="mx-auto w-full max-w-4xl px-4 pb-12 pt-8">
    <h1 class="mb-4 text-2xl font-semibold">{frontmatter.title}</h1>
    <slot name="before" />
    <section id="about" class="panel prose max-w-none prose-img:border-0">
      <slot />
    </section>
  </main>
  <Footer />
</Layout>
