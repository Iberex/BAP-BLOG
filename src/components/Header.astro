---
import home from "../data/home.json";

export interface Props {
  activeNav?: "posts" | "tags" | "about" | "search" | "planning" | "team";
}

const { activeNav } = Astro.props;
const base = import.meta.env.BASE_URL;
const items = [
  { key: "posts", label: "blog", href: `${base}posts/` },
  { key: "planning", label: "agenda", href: `${base}planning/` },
  { key: "team", label: "team", href: `${base}team/` },
  { key: "about", label: "over", href: `${base}about/` },
];
---

<header class="site-header">
  <a id="skip-to-content" href="#main-content" class="sr-only">Naar inhoud</a>
  <nav class="site-nav">
    <h2 class="site-nav__title">
      <a href={base} class="plain">{home.titel}</a>
    </h2>
    <div class="site-nav__list">
      {
        items.map(({ key, label, href }) => (
          <div class="site-nav__list-item">
            <a href={href} class={activeNav === key ? "active" : ""}>
              {label}
            </a>
          </div>
        ))
      }
    </div>
  </nav>
</header>
