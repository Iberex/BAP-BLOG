---
// Top of a post: title with the pillars beside it, then who wrote it and when.
import { slugifyStr } from "@utils/slugify";
import { pijlerLabel } from "@utils/pijlers";
import { SOORTEN } from "@utils/soorten";
import { LOCALE } from "@config";
import { iconSvg, pijlerIconSvg } from "@utils/icons";

export interface Props {
  title?: string;
  author?: string;
  soort?: string;
  soorten?: string[];
  taak?: string | null;
  date?: Date | string;
  pijlers?: string[];
  cover?: string;
}

const { title, author, soort, date, pijlers = [], cover, taak } = Astro.props;
const soorten = Astro.props.soorten ?? (soort ? [soort] : []);
const base = import.meta.env.BASE_URL;
const datum = date ? new Date(date) : null;
const photo = ["Ibe", "Tjorven", "Senne"].includes(author ?? "")
  ? `${base}team/${author!.toLowerCase()}.jpg`
  : null;
---

<header class="post-head">
  {cover && <img src={cover} alt="" class="post-cover" />}
  <div class="post-head__top">
    <h1 class="post-title">{title}</h1>
    {
      datum && (
        <time class="post-date" datetime={datum.toISOString()}>
          {datum.toLocaleDateString(LOCALE.langTag, {
            day: "numeric",
            month: "short",
            year: "numeric",
          })}
        </time>
      )
    }
  </div>
  <p class="post-meta">
    {
      author && (
        <span class="post-author">
          {photo && <img src={photo} alt="" class="post-avatar" />}
          {author}
        </span>
      )
    }
    {
      soorten.map(s => (
        <a href={`${base}posts/?soort=${slugifyStr(s)}`} class="tag">
          <Fragment set:html={iconSvg("tag")} />
          {SOORTEN[s]?.label ?? s}
        </a>
      ))
    }
    {
      taak && (
        <a href={`${base}planning/`} class="tag tag--taak">
          <Fragment set:html={iconSvg("list-checks")} />
          Taak: {taak}
        </a>
      )
    }
    {
      pijlers.map(p => (
        <a href={`${base}posts/?pijler=${slugifyStr(p)}`} class="tag">
          <Fragment set:html={pijlerIconSvg(slugifyStr(p))} />
          {pijlerLabel(p)}
        </a>
      ))
    }
  </p>
</header>
