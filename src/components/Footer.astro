---
import home from "../data/home.json";
import team from "../data/team.json";

export interface Props {
  noMarginTop?: boolean;
}

import { beheerUrl, inEditor } from "@utils/editor";

// Old posts, home and team are still edited in Pages CMS.
const pagesCms = "https://app.pagescms.org/iberex/BAP-BLOG";
---

<footer class="site-footer">
  <p>
    <span class="site-footer__title">{home.titel}</span>
    · {team.map(({ naam }) => naam).join(", ")}
  </p>
  <p class="site-footer__links">
    {home.email && <a href={`mailto:${home.email}`}>{home.email}</a>}
    {
      home.links.map(({ naam, url }) => (
        <a href={url} target="_blank" rel="noopener">
          {naam}
        </a>
      ))
    }
    <a href={beheerUrl} target={inEditor ? "_top" : "_blank"} rel="noopener">
      Beheer
    </a>
    <a href={pagesCms} target="_blank" rel="noopener">Oude posts, home, team</a>
  </p>
</footer>
