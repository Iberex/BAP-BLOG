---
import home from "../data/home.json";
import team from "../data/team.json";

export interface Props {
  noMarginTop?: boolean;
}

// Posts, home and team are edited in Pages CMS.
const order = ["Senne", "Tjorven", "Ibe"];
const names = team
  .map(({ naam }) => naam)
  .sort((a, b) => order.indexOf(a) - order.indexOf(b));
const pagesCms = "https://app.pagescms.org/iberex/BAP-BLOG";
---

<footer class="site-footer">
  <div class="site-footer__who">
    <span class="site-footer__title">Bachelorproef</span>
    <span class="site-footer__team">{names.join(", ")}</span>
  </div>
  <div class="site-footer__links">
    {home.email && <a href={`mailto:${home.email}`}>{home.email}</a>}
    {
      home.links.map(({ naam, url }) => (
        <a href={url} target="_blank" rel="noopener">
          {naam}
        </a>
      ))
    }
    <a href={pagesCms} target="_blank" rel="noopener">Beheer</a>
  </div>
</footer>
