---
import Hr from "./Hr.astro";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class={`${noMarginTop ? "" : "mt-auto"}`}>
  <Hr noPadding />
  <div class="footer-wrapper">
    <div class="copyright-wrapper">
      <span>Bachelorproef Devine 2026–2027</span>
      <span class="separator">&nbsp;|&nbsp;</span>
      <span>Jeugdfilmfestival Antwerpen</span>
      <span class="separator">&nbsp;|&nbsp;</span>
      <a
        href="https://app.pagescms.org/iberex/BAP-BLOG/main/collection/posts/new"
        class="underline underline-offset-4">+ Nieuwe post</a
      >
      <span class="separator">&nbsp;|&nbsp;</span>
      <a
        href="https://app.pagescms.org/iberex/BAP-BLOG"
        class="underline underline-offset-4">Beheer</a
      >
    </div>
  </div>
</footer>

<style>
  footer {
    @apply w-full;
  }
  .footer-wrapper {
    @apply flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4;
  }
  .link-button {
    @apply my-1 p-2;
  }
  .link-button svg {
    @apply scale-125;
  }
  .copyright-wrapper {
    @apply my-2 flex flex-col items-center whitespace-nowrap sm:flex-row;
  }
  .separator {
    @apply hidden sm:inline;
  }
</style>
