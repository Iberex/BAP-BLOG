---
// Text with formatting from a block: Markdown, as saved in the .md file.
import { createMarkdownProcessor } from "@astrojs/markdown-remark";

export interface Props {
  tekst?: unknown;
}

const { tekst } = Astro.props;
const html =
  typeof tekst === "string" && tekst
    ? (await (await createMarkdownProcessor()).render(tekst)).code
    : "";
---

<div class="rijke-tekst">
  <Fragment set:html={html} />
</div>

<style>
  .rijke-tekst :global(p + p) {
    @apply mt-3;
  }
  .rijke-tekst :global(ul),
  .rijke-tekst :global(ol) {
    @apply my-3 space-y-1 pl-5;
  }
  .rijke-tekst :global(ul) {
    @apply list-disc;
  }
  .rijke-tekst :global(ol) {
    @apply list-decimal;
  }
  .rijke-tekst :global(a) {
    @apply underline decoration-dashed underline-offset-4;
  }
  .rijke-tekst :global(strong) {
    @apply font-semibold;
  }
</style>
