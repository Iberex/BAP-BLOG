---
// Title, meta, summary and blocks of a post built from blocks ("Posts (blokken)" in Pages CMS).
import Inhoud from "./Inhoud.astro";
import PostHead from "@components/PostHead.astro";

export interface Props {
  data?: Record<string, any> | null;
}

const data = Astro.props.data ?? {};
// A picture as the very first block is the cover: show it once, at the top.
const inhoud = data.inhoud ?? [];
const blokken = inhoud[0]?._template === "beeld" ? inhoud.slice(1) : inhoud;
---

<PostHead
  title={data.title}
  author={data.author}
  soort={data.soort}
  soorten={data.soorten}
  taak={data.taak}
  date={data.pubDatetime}
  pijlers={data.pijlers}
  cover={data.beelden?.[0]?.src}
/>

<div class="post-content">
  {data.samenvatting && <p class="summary">{data.samenvatting}</p>}
  <Inhoud blokken={blokken} />
</div>
