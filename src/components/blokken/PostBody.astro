---
// Title, meta, summary and blocks of a post built from blocks ("Posts (blokken)" in Pages CMS).
import Inhoud from "./Inhoud.astro";
import { slugifyStr } from "@utils/slugify";
import { SOORTEN } from "@utils/soorten";
import { LOCALE } from "@config";

export interface Props {
  data?: Record<string, any> | null;
}

const data = Astro.props.data ?? {};
const base = import.meta.env.BASE_URL;
const datum = data.pubDatetime ? new Date(data.pubDatetime) : null;
---

<header class="post-head">
  <h1 class="post-title">{data.title}</h1>
  <p class="post-meta">
    {
      data.soort && (
        <a
          href={`${base}posts/?soort=${slugifyStr(data.soort)}`}
          class="post-soort"
        >
          {SOORTEN[data.soort]?.label ?? data.soort}
        </a>
      )
    }
    {
      datum && (
        <time datetime={datum.toISOString()}>
          {datum.toLocaleDateString(LOCALE.langTag, {
            day: "numeric",
            month: "long",
            year: "numeric",
          })}
        </time>
      )
    }
    {data.author && <span>{data.author}</span>}
  </p>
</header>

<div class="post-content">
  {data.samenvatting && <p class="summary">{data.samenvatting}</p>}
  <Inhoud blokken={data.inhoud} />
</div>
