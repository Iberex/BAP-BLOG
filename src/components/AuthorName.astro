---
export interface Props {
  name: string;
}

const { name } = Astro.props;

// Sticker per teamlid: zet een PNG in public/stickers/ en voeg de naam hier toe.
const stickers: Record<string, string> = {
  Senne: "senne.png",
};
const sticker = stickers[name];
---

<span class="not-prose inline-flex items-center gap-2 align-middle">
  {name}
  {
    sticker && (
      <img
        src={`${import.meta.env.BASE_URL}stickers/${sticker}`}
        alt=""
        class="sticker"
        width="313"
        height="360"
      />
    )
  }
</span>

<style>
  .sticker {
    @apply h-12 w-auto -rotate-6;
  }
</style>
