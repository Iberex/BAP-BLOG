---
export interface Props {
  name: string;
}

const { name } = Astro.props;

// Foto per teamlid: public/team/<naam>.jpg (Ibe, Tjorven, Senne).
const photo = ["Ibe", "Tjorven", "Senne"].includes(name)
  ? `${import.meta.env.BASE_URL}team/${name.toLowerCase()}.jpg`
  : null;
---

<span class="not-prose inline-flex items-center gap-2 align-middle">
  {photo && <img src={photo} alt="" class="avatar" width="28" height="28" />}
  {name}
</span>

<style>
  .avatar {
    @apply h-7 w-7 rounded-full object-cover;
  }
</style>
