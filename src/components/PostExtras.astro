---
import type { CollectionEntry } from "astro:content";
import { SOORTEN } from "@utils/soorten";
import { paragraphs, fragmentId } from "@utils/fragments";

export interface Props {
  data: CollectionEntry<"blog">["data"];
}

const {
  samenvatting,
  soort,
  blokken,
  playtest,
  bron,
  ai,
  actiepunten,
  beelden,
  fragments,
} = Astro.props.data;

const lines = (value?: string | null) =>
  (value ?? "")
    .split("\n")
    .map(line => line.replace(/^[-*]\s*/, "").trim())
    .filter(Boolean);

// Short facts shown as one box above the text.
const facts = [
  ["Testers", playtest?.testers],
  ["Groepen", playtest?.groepen],
  ["Leeftijd", playtest?.leeftijd],
  ["Wat getest", playtest?.wat],
  [soort === "meeting" ? "Met" : "Van", bron],
  ["Tool", ai?.tool],
  ["Waarvoor", ai?.waarvoor],
].filter(([, value]) => value);

// Each paragraph gets an id so a tag filter can link straight to it.
const sections = (SOORTEN[soort ?? ""]?.blokken ?? [])
  .map(([key, label]) => ({
    label,
    paragraphs: paragraphs(blokken?.[key]).map((text, index) => ({
      id: fragmentId(key, index),
      tags: fragments.find(f => f.id === fragmentId(key, index))?.tags ?? [],
      text,
    })),
  }))
  .filter(section => section.paragraphs.length > 0);

const actions = lines(actiepunten);
---

{samenvatting && <p class="summary">{samenvatting}</p>}

{
  facts.length > 0 && (
    <dl class="box">
      {facts.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  )
}

{
  sections.map(section => (
    <section class="block">
      <h2>{section.label}</h2>
      {section.paragraphs.map(paragraph => (
        <p
          id={paragraph.id}
          class:list={["text", { tagged: paragraph.tags.length > 0 }]}
        >
          {paragraph.text}
        </p>
      ))}
    </section>
  ))
}

{
  beelden.length > 0 && (
    <section class="block">
      <h2>Beelden</h2>
      <div class="beelden">
        {beelden.map(beeld => (
          <figure>
            <a href={beeld.src} target="_blank" rel="noopener">
              <img
                src={beeld.src}
                alt={beeld.bijschrift ?? ""}
                loading="lazy"
              />
            </a>
            {beeld.bijschrift && <figcaption>{beeld.bijschrift}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )
}

{
  actions.length > 0 && (
    <section class="block">
      <h2>Actiepunten</h2>
      <ul>
        {actions.map(action => (
          <li>{action}</li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .summary {
    @apply mb-6 text-lg opacity-80;
  }
  .box {
    @apply mx-0 mb-6 flex flex-wrap gap-x-8 gap-y-2 rounded-lg bg-skin-card px-4 py-3;
  }
  dt {
    @apply text-sm opacity-70;
  }
  .block {
    @apply mx-0 mb-8 px-0;
  }
  .block h2 {
    @apply mb-2 text-xl font-semibold;
  }
  .text + .text {
    @apply mt-3;
  }
  .text.tagged {
    @apply scroll-mt-6;
  }
  .text:target {
    @apply -mx-2 rounded-md bg-skin-card px-2 py-1;
  }
  .beelden {
    @apply grid gap-4 sm:grid-cols-2;
  }
  .beelden figure {
    @apply m-0;
  }
  .beelden img {
    @apply aspect-[4/3] w-full rounded-lg border border-skin-line object-cover;
  }
  figcaption {
    @apply mt-1 text-sm opacity-70;
  }
  ul {
    @apply ml-5 list-disc;
  }
</style>
