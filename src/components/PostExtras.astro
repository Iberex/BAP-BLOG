---
import type { CollectionEntry } from "astro:content";
import { SOORTEN } from "@utils/soorten";
import { paragraphs, tagsIn, withoutTags, fragmentId } from "@utils/fragments";
import { pijlerLabel } from "@utils/pijlers";

export interface Props {
  data: CollectionEntry<"blog">["data"];
}

const { samenvatting, soort, blokken, playtest, bron, ai, actiepunten } =
  Astro.props.data;

const lines = (value?: string | null) =>
  (value ?? "")
    .split("\n")
    .map(line => line.replace(/^[-*]\s*/, "").trim())
    .filter(Boolean);

// Short facts shown as one box above the text.
const facts = [
  ["Testers", playtest?.testers],
  ["Groepen", playtest?.groepen],
  ["Leeftijd", playtest?.leeftijd],
  ["Wat getest", playtest?.wat],
  [soort === "meeting" ? "Met" : "Van", bron],
  ["Tool", ai?.tool],
  ["Waarvoor", ai?.waarvoor],
].filter(([, value]) => value);

// Each paragraph gets an id so a tag filter can link straight to it.
const sections = (SOORTEN[soort ?? ""]?.blokken ?? [])
  .map(([key, label]) => ({
    label,
    paragraphs: paragraphs(blokken?.[key]).map((text, index) => ({
      id: fragmentId(key, index),
      tags: tagsIn(text),
      text: withoutTags(text),
    })),
  }))
  .filter(section => section.paragraphs.length > 0);
const tagLabel = (tag: string) => SOORTEN[tag]?.label ?? pijlerLabel(tag);

const actions = lines(actiepunten);
---

{samenvatting && <p class="summary">{samenvatting}</p>}

{
  facts.length > 0 && (
    <dl class="box">
      {facts.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  )
}

{
  sections.map(section => (
    <section class="block">
      <h2>{section.label}</h2>
      {section.paragraphs.map(paragraph => (
        <p
          id={paragraph.id}
          class:list={["text", { tagged: paragraph.tags.length > 0 }]}
        >
          {paragraph.tags.map(tag => (
            <span class={`pill pill-${tag} soort-${tag} mr-1.5 align-middle`}>
              {tagLabel(tag)}
            </span>
          ))}
          {paragraph.text}
        </p>
      ))}
    </section>
  ))
}

{
  actions.length > 0 && (
    <section class="block">
      <h2>Actiepunten</h2>
      <ul>
        {actions.map(action => (
          <li>{action}</li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .summary {
    @apply mb-6 text-lg opacity-80;
  }
  .box {
    @apply mx-0 mb-6 flex flex-wrap gap-x-8 gap-y-2 rounded-lg bg-skin-card px-4 py-3;
  }
  dt {
    @apply text-sm opacity-70;
  }
  .block {
    @apply mx-0 mb-8 px-0;
  }
  .block h2 {
    @apply mb-2 text-xl font-semibold;
  }
  .text + .text {
    @apply mt-3;
  }
  .text.tagged {
    @apply scroll-mt-6;
  }
  .text:target {
    @apply -mx-2 rounded-md bg-skin-card px-2 py-1;
  }
  ul {
    @apply ml-5 list-disc;
  }
</style>
