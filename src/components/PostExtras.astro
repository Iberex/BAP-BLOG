---
import type { CollectionEntry } from "astro:content";

export interface Props {
  data: CollectionEntry<"blog">["data"];
}

const { samenvatting, week, playtest, feedback, ai } = Astro.props.data;

// Fixed order of the weekly report, based on the Curtain Call team blog.
const weekBlocks = [
  ["voortgang", "Voortgang"],
  ["ux", "UX"],
  ["design", "Design"],
  ["dev", "Development"],
  ["playtest", "Playtest"],
  ["feedback", "Feedback"],
  ["ai", "AI-gebruik"],
  ["volgende", "Volgende stappen"],
] as const;

const lines = (value?: string | null) =>
  (value ?? "")
    .split("\n")
    .map(line => line.replace(/^[-*]\s*/, "").trim())
    .filter(Boolean);

const testFacts = [
  ["Testers", playtest?.testers],
  ["Groepen", playtest?.groepen],
  ["Leeftijd", playtest?.leeftijd],
  ["Wat getest", playtest?.wat],
].filter(([, value]) => value);

const actions = lines(feedback?.actiepunten);
const hasAi = ai?.tool || ai?.waarvoor || ai?.kritisch;
---

{samenvatting && <p class="summary">{samenvatting}</p>}

{
  (testFacts.length > 0 || playtest?.bevindingen) && (
    <section class="box" aria-label="Playtest">
      <h2>Playtest</h2>
      <dl>
        {testFacts.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      {playtest?.bevindingen && <p class="text">{playtest.bevindingen}</p>}
    </section>
  )
}

{
  (feedback?.bron || actions.length > 0) && (
    <section class="box" aria-label="Feedback">
      <h2>Feedback{feedback?.bron && ` van ${feedback.bron}`}</h2>
      {actions.length > 0 && (
        <>
          <p class="label">Actiepunten</p>
          <ul>
            {actions.map(action => (
              <li>{action}</li>
            ))}
          </ul>
        </>
      )}
    </section>
  )
}

{
  hasAi && (
    <section class="box" aria-label="AI-gebruik">
      <h2>AI-gebruik</h2>
      <dl>
        {ai?.tool && (
          <div>
            <dt>Tool</dt>
            <dd>{ai.tool}</dd>
          </div>
        )}
        {ai?.waarvoor && (
          <div>
            <dt>Waarvoor</dt>
            <dd>{ai.waarvoor}</dd>
          </div>
        )}
      </dl>
      {ai?.kritisch && (
        <>
          <p class="label">Wat klopte niet / wat pasten we aan</p>
          <p class="text">{ai.kritisch}</p>
        </>
      )}
    </section>
  )
}

{
  week &&
    weekBlocks.map(
      ([key, label]) =>
        week[key] && (
          <section class="week">
            <h2>{label}</h2>
            <p class="text">{week[key]}</p>
          </section>
        )
    )
}

<style>
  .summary {
    @apply mb-6 text-lg opacity-80;
  }
  .box {
    @apply mx-0 mb-6 rounded-lg bg-skin-card px-4 py-3;
  }
  .box h2,
  .week h2 {
    @apply mb-2 font-semibold;
  }
  .week {
    @apply mx-0 mb-8 px-0;
  }
  .week h2 {
    @apply text-xl;
  }
  dl {
    @apply flex flex-wrap gap-x-8 gap-y-2;
  }
  dt,
  .label {
    @apply text-sm opacity-70;
  }
  .text {
    @apply mt-2 whitespace-pre-line;
  }
  ul {
    @apply ml-5 list-disc;
  }
</style>
