---
import type { CollectionEntry } from "astro:content";
import { SOORTEN } from "@utils/soorten";
import { paragraphs, fragmentId } from "@utils/fragments";
import { vimeoEmbed, muxVideo } from "@utils/vimeo";
import MuxVideo from "@components/MuxVideo.astro";

export interface Props {
  data: CollectionEntry<"blog">["data"];
}

const {
  samenvatting,
  soort,
  blokken,
  playtest,
  actiepunten,
  beelden,
  bestanden,
  videos: allVideos,
  video,
  fragments,
} = Astro.props.data;

const topIsVideo = !beelden[0] && !video;
const videos = topIsVideo ? allVideos.slice(1) : allVideos;
const gallery = beelden.slice(1);

const lines = (value?: string | null) =>
  (value ?? "")
    .split("\n")
    .map(line => line.replace(/^[-*]\s*/, "").trim())
    .filter(Boolean);

// Short facts shown as one box above the text.
const facts = [
  ["Testers", playtest?.testers],
  ["Groepen", playtest?.groepen],
  ["Leeftijd", playtest?.leeftijd],
  ["Wat getest", playtest?.wat],
].filter(([, value]) => value);

// Each paragraph gets an id so a tag filter can link straight to it.
const sections = (SOORTEN[soort ?? ""]?.blokken ?? [])
  .map(([key, label]) => ({
    label,
    paragraphs: paragraphs(blokken?.[key]).map((text, index) => ({
      id: fragmentId(key, index),
      tags: fragments.find(f => f.id === fragmentId(key, index))?.tags ?? [],
      text,
    })),
  }))
  .filter(section => section.paragraphs.length > 0)
  // Lines starting with "- " or "1. " become a bullet or numbered list.
  .map(section => ({
    ...section,
    groups: section.paragraphs.reduce<
      { list?: "ul" | "ol"; items: typeof section.paragraphs }[]
    >((groups, paragraph) => {
      const list = /^-\s/.test(paragraph.text)
        ? "ul"
        : /^\d+\.\s/.test(paragraph.text)
          ? "ol"
          : undefined;
      const item = list
        ? { ...paragraph, text: paragraph.text.replace(/^(-|\d+\.)\s+/, "") }
        : paragraph;
      const last = groups[groups.length - 1];
      if (list && last?.list === list) last.items.push(item);
      else groups.push({ list, items: [item] });
      return groups;
    }, []),
  }));

// "Femto: 30 fps" -> "Femto" in bold, then the rest.
const labelled = (text: string) => {
  const match = text.match(/^([^:]{1,30}):\s+(.+)$/);
  return match ? { label: match[1], rest: match[2] } : { rest: text };
};

const actions = lines(actiepunten);

// "/BAP-BLOG/bestanden/plan.pdf" -> name "plan.pdf", type "PDF".
const files = bestanden.map(({ src, naam }) => {
  const file = decodeURIComponent(src!.split("/").pop() ?? "");
  return {
    src,
    naam: naam || file,
    type: file.split(".").pop()?.toUpperCase(),
  };
});
---

{samenvatting && <p class="summary">{samenvatting}</p>}

{
  facts.length > 0 && (
    <dl class="box">
      {facts.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  )
}

{
  sections.map(section => (
    <section class="block">
      <h2>{section.label}</h2>
      {section.groups.map(group => {
        if (!group.list)
          return group.items.map(paragraph => (
            <p
              id={paragraph.id}
              class:list={["text", { tagged: paragraph.tags.length > 0 }]}
            >
              {paragraph.text}
            </p>
          ));
        const List = group.list;
        return (
          <List class="tekst-lijst">
            {group.items.map(item => {
              const { label, rest } = labelled(item.text);
              return (
                <li
                  id={item.id}
                  class:list={["text", { tagged: item.tags.length > 0 }]}
                >
                  {label && <strong>{`${label}: `}</strong>}
                  {rest}
                </li>
              );
            })}
          </List>
        );
      })}
    </section>
  ))
}

{
  videos.length > 0 && (
    <section class="block">
      <h2>Video's</h2>
      <div class="videos">
        {videos.map(video => {
          const src = vimeoEmbed(video.link);
          const mux = src ? null : muxVideo(video.link);
          return (
            (src || mux) && (
              <figure>
                {mux ? (
                  <MuxVideo {...mux} title={video.titel} class="frame" />
                ) : (
                  <iframe
                    src={src}
                    title={video.titel ?? "Video"}
                    allow="fullscreen; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                    class="frame"
                  />
                )}
                {video.titel && <figcaption>{video.titel}</figcaption>}
              </figure>
            )
          );
        })}
      </div>
    </section>
  )
}

{
  gallery.length > 0 && (
    <section class="block">
      <h2>Beelden</h2>
      <div class="beelden">
        {gallery.map(beeld => (
          <figure>
            <a href={beeld.src} target="_blank" rel="noopener">
              <img
                src={beeld.src}
                alt={beeld.bijschrift ?? ""}
                loading="lazy"
              />
            </a>
            {beeld.bijschrift && <figcaption>{beeld.bijschrift}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )
}

{
  files.length > 0 && (
    <section class="block">
      <h2>Bestanden</h2>
      <ul class="files">
        {files.map(file => (
          <li>
            <a href={file.src} target="_blank" rel="noopener">
              <span class="file-type">{file.type}</span>
              {file.naam}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  actions.length > 0 && (
    <section class="block">
      <h2>Actiepunten</h2>
      <ul>
        {actions.map(action => (
          <li>{action}</li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .summary {
    @apply mb-6 text-lg opacity-80;
  }
  .box {
    @apply mx-0 mb-6 flex flex-wrap gap-x-8 gap-y-2 rounded-lg bg-skin-card px-4 py-3;
  }
  dt {
    @apply text-sm opacity-70;
  }
  .block {
    @apply mx-0 mb-8 px-0;
  }
  .block h2 {
    @apply mb-2 text-xl font-semibold;
  }
  .text + .text {
    @apply mt-3;
  }
  .tekst-lijst {
    @apply my-3 space-y-1 pl-5;
  }
  ul.tekst-lijst {
    @apply list-disc;
  }
  ol.tekst-lijst {
    @apply list-decimal;
  }
  .tekst-lijst .text + .text {
    @apply mt-1;
  }
  .text.tagged {
    @apply scroll-mt-6;
  }
  .text:target {
    @apply -mx-2 rounded-md bg-skin-card px-2 py-1;
  }
  .beelden {
    @apply grid gap-4 sm:grid-cols-2;
  }
  .videos {
    @apply grid gap-4 sm:grid-cols-2;
  }
  .videos figure:first-child:nth-last-child(odd) {
    grid-column: 1 / -1;
  }
  .videos figure {
    @apply m-0;
  }
  .videos .frame {
    @apply aspect-video h-auto w-full rounded-lg border border-skin-line;
  }
  .beelden figure {
    @apply m-0;
  }
  .beelden img {
    @apply aspect-[4/3] w-full rounded-lg border border-skin-line object-cover;
  }
  figcaption {
    @apply mt-1 text-sm opacity-70;
  }
  .files {
    @apply ml-0 list-none;
  }
  .files a {
    @apply flex items-center gap-3 rounded-lg bg-skin-card px-3 py-2 hover:underline;
  }
  .files li + li {
    @apply mt-2;
  }
  .file-type {
    @apply rounded border border-skin-line px-1.5 text-xs font-medium opacity-70;
  }
  ul {
    @apply ml-5 list-disc;
  }
</style>
