---
// Plays a Mux video with the <mux-player> web component.
export interface Props {
  playbackId: string;
  poster: string;
  title?: string | null;
  class?: string;
}

const { playbackId, poster, title, class: className } = Astro.props;
---

<mux-player
  playback-id={playbackId}
  poster={poster}
  title={title ?? undefined}
  metadata-video-title={title ?? undefined}
  stream-type="on-demand"
  accent-color="#2f5be0"
  primary-color="#ffffff"
  secondary-color="#232323"
  class:list={["mux", className]}></mux-player>

<script>
  import "@mux/mux-player";
</script>

<style>
  .mux {
    display: block;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background-color: #f3f1eb;
    --media-primary-color: #fff;
    --media-secondary-color: rgba(35, 35, 35, 0.85);
    --media-accent-color: #2f5be0;
  }
</style>
