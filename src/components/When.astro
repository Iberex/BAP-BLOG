---
// Coloured label like "morgen" or "over 6 dagen", filled in by the browser
// so it stays right between builds. Stays empty once the item is over.
export interface Props {
  start: string;
  end?: string;
}

const { start, end = start } = Astro.props;
---

<span data-when-start={start} data-when-end={end}></span>

<script>
  const today = new Date().toISOString().slice(0, 10);
  const DAY = 24 * 60 * 60 * 1000;

  document.querySelectorAll<HTMLElement>("[data-when-start]").forEach(el => {
    const start = el.dataset.whenStart!;
    const end = el.dataset.whenEnd || start;
    if (end < today) return;

    const days = Math.round((Date.parse(start) - Date.parse(today)) / DAY);
    const [text, tone] =
      days < 0
        ? ["bezig", "nu"]
        : days === 0
          ? ["vandaag", "dringend"]
          : days === 1
            ? ["morgen", "dringend"]
            : days <= 3
              ? [`over ${days} dagen`, "dringend"]
              : days <= 7
                ? [`over ${days} dagen`, "snel"]
                : days <= 21
                  ? [`over ${days} dagen`, "binnenkort"]
                  : [`over ${Math.round(days / 7)} weken`, "later"];

    el.textContent = text;
    el.dataset.tone = tone;
    el.classList.add("when");
  });
</script>
