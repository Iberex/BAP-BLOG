---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE, SUPABASE } from "@config";
import team from "../data/team.json";

const ready = Boolean(SUPABASE.url && SUPABASE.key);
const base = import.meta.env.BASE_URL;
---

<Layout title={`Uren | ${SITE.title}`}>
  <Header activeNav="uren" />
  <main id="main-content" class="page uren">
    <h2 class="page-title">Uren</h2>

    {
      !ready ? (
        <p class="uren-empty">De uren zijn nog niet gekoppeld.</p>
      ) : (
        <>
          <p class="uren-empty" data-message hidden />

          {/* Who is working right now. */}
          <div class="people">
            {team.map(({ naam }) => (
              <div class="person" data-person={naam}>
                <div class="person__head">
                  <img src={`${base}team/${naam.toLowerCase()}.jpg`} alt="" />
                  <strong>{naam}</strong>
                  <span class="person__light" aria-hidden="true" />
                </div>
                <p class="person__clock" data-clock>
                  –
                </p>
                <p class="person__line" data-state />
              </div>
            ))}
          </div>

          {/* Hours per day this week: the darker, the longer. */}
          <div class="planner-bar uren-bar">
            <div class="weeks-nav">
              <button
                type="button"
                class="arrow"
                data-week="-1"
                aria-label="Vorige week"
              >
                ‹
              </button>
              <span class="range" data-week-title />
              <button
                type="button"
                class="arrow"
                data-week="1"
                aria-label="Volgende week"
              >
                ›
              </button>
            </div>
            <a
              class="quiet-link"
              href="https://track.toggl.com/timer"
              target="_blank"
              rel="noopener"
            >
              Open Toggl
            </a>
          </div>
          <div class="planner-card">
            <div class="week" data-week-grid />
          </div>

          <h3 class="uren-title">Laatste sessies</h3>
          <div class="planner-card">
            <ul class="sessions" data-sessions />
          </div>
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  import { createClient } from "@supabase/supabase-js";
  import { SUPABASE } from "@config";

  type Timer = { wie: string; sinds: string; wat: string };
  type Sessie = {
    id: string;
    wie: string;
    van: string;
    tot: string;
    wat: string;
  };

  const grid = document.querySelector<HTMLElement>("[data-week-grid]");
  if (grid && SUPABASE.url && SUPABASE.key) {
    const db = createClient(SUPABASE.url, SUPABASE.key);
    const $ = <T extends HTMLElement>(selector: string) =>
      document.querySelector<T>(selector)!;
    const people = [...document.querySelectorAll<HTMLElement>("[data-person]")];
    const names = people.map(p => p.dataset.person!);

    let timers: Timer[] = [];
    let sessies: Sessie[] = [];

    // ---- time helpers
    const HOUR = 3600_000;
    const DAY = 24 * HOUR;
    const pad = (n: number) => String(n).padStart(2, "0");
    const dayKey = (time: number | string) => {
      const d = new Date(time);
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    };
    const length = (s: { van: string; tot: string }) =>
      Date.parse(s.tot) - Date.parse(s.van);
    // 5412000 -> "1:30:12", exact to the second
    const clock = (ms: number) => {
      const s = Math.max(0, Math.floor(ms / 1000));
      return `${Math.floor(s / 3600)}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;
    };
    // 5412000 -> "1:30" for small spaces; the exact time is in the tooltip
    const hm = (ms: number) => {
      const m = Math.floor(ms / 60000);
      return m > 0 ? `${Math.floor(m / 60)}:${pad(m % 60)}` : "";
    };
    const time = (iso: string) =>
      new Date(iso).toLocaleTimeString("nl-BE", {
        hour: "2-digit",
        minute: "2-digit",
      });
    const dayLabel = (key: string, options: Intl.DateTimeFormatOptions) =>
      new Date(`${key}T12:00:00`).toLocaleDateString("nl-BE", options);
    const el = (tag: string, cls = "", text = "") => {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text) node.textContent = text;
      return node;
    };

    // Week 1 of the bachelor project starts on Monday 26 October 2026.
    const START = new Date(2026, 9, 26).getTime();
    const weekOf = (t: number) => Math.floor((t - START) / (7 * DAY)) + 1;
    let week = Math.max(1, weekOf(Date.now()));

    // Time worked on one day by one person, including a timer that is running now.
    function worked(person: string, key: string, now: number) {
      let total = sessies
        .filter(s => s.wie === person && dayKey(s.van) === key)
        .reduce((sum, s) => sum + length(s), 0);
      const timer = timers.find(t => t.wie === person);
      if (timer && dayKey(timer.sinds) === key)
        total += now - Date.parse(timer.sinds);
      return total;
    }

    // ---- drawing
    function renderPeople() {
      const now = Date.now();
      for (const card of people) {
        const person = card.dataset.person!;
        const timer = timers.find(t => t.wie === person);
        const today = worked(person, dayKey(now), now);
        card.classList.toggle("person--on", Boolean(timer));
        card.querySelector("[data-clock]")!.textContent = timer
          ? clock(now - Date.parse(timer.sinds))
          : "niet bezig";
        card.querySelector("[data-state]")!.textContent = timer
          ? timer.wat || "aan het werk"
          : `vandaag ${hm(today) || "0:00"}`;
      }
    }

    function renderWeek() {
      const now = Date.now();
      const monday = START + (week - 1) * 7 * DAY;
      const days = Array.from({ length: 7 }, (_, i) =>
        dayKey(monday + i * DAY + 12 * HOUR)
      );
      const short = { day: "numeric", month: "short" } as const;
      $("[data-week-title]").textContent =
        `Week ${week} · ${dayLabel(days[0], short)} – ${dayLabel(days[6], short)}`;

      const cells: HTMLElement[] = [el("div", "week__corner")];
      for (const key of days) {
        const head = el(
          "div",
          `week__day${key === dayKey(now) ? " is-today" : ""}`
        );
        head.append(
          el("span", "", dayLabel(key, { weekday: "short" })),
          el("strong", "", dayLabel(key, { day: "numeric" }))
        );
        cells.push(head);
      }
      cells.push(el("div", "week__day week__total-head", "totaal"));

      for (const person of names) {
        const name = el("div", "week__name");
        const photo = document.createElement("img");
        photo.src = `${import.meta.env.BASE_URL}team/${person.toLowerCase()}.jpg`;
        photo.alt = "";
        name.append(photo, person);
        cells.push(name);
        let total = 0;
        for (const key of days) {
          const ms = worked(person, key, now);
          total += ms;
          const cell = el(
            "div",
            `week__cell${key === dayKey(now) ? " is-today" : ""}`,
            hm(ms)
          );
          // 8 hours or more is the darkest.
          const strength = Math.min(ms / (8 * HOUR), 1);
          cell.style.setProperty(
            "--strength",
            String(ms > 0 ? 0.12 + strength * 0.78 : 0)
          );
          if (strength > 0.45) cell.classList.add("is-dark");
          cell.title =
            ms > 0
              ? `${person} · ${dayLabel(key, { weekday: "long" })}: ${clock(ms)}`
              : "";
          cells.push(cell);
        }
        cells.push(el("div", "week__total", hm(total) || "–"));
      }
      grid!.replaceChildren(...cells);
    }

    function renderSessions() {
      const items = [...sessies]
        .sort((a, b) => b.van.localeCompare(a.van))
        .slice(0, 5)
        .map(s => {
          const li = el("li");
          li.append(
            el(
              "span",
              "sessions__when",
              `${dayLabel(dayKey(s.van), { weekday: "short", day: "numeric", month: "short" })} · ${time(s.van)}`
            ),
            el("span", "sessions__who", s.wie),
            el("span", "sessions__what", s.wat || "—"),
            el("span", "sessions__length", hm(length(s)))
          );
          return li;
        });
      if (!items.length)
        items.push(el("li", "sessions__empty", "Nog geen uren."));
      $("[data-sessions]").replaceChildren(...items);
    }

    function render() {
      renderPeople();
      renderWeek();
      renderSessions();
    }

    // ---- data
    async function load() {
      const [t, s] = await Promise.all([
        db.from("timers").select("wie, sinds, wat"),
        db.from("sessies").select("id, wie, van, tot, wat").order("van"),
      ]);
      const message = $("[data-message]");
      message.hidden = !(t.error || s.error);
      message.textContent = "De uren konden niet geladen worden.";
      if (t.error || s.error) return;
      timers = t.data as Timer[];
      sessies = s.data as Sessie[];
      render();
    }

    // Live: reload whenever Toggl reports a change.
    db.channel("uren")
      .on(
        "postgres_changes",
        { event: "*", schema: "public", table: "timers" },
        load
      )
      .on(
        "postgres_changes",
        { event: "*", schema: "public", table: "sessies" },
        load
      )
      .subscribe();
    // The clocks of running timers count every second.
    setInterval(() => {
      if (timers.length) {
        renderPeople();
        renderWeek();
      }
    }, 1000);

    document
      .querySelectorAll<HTMLButtonElement>("[data-week]")
      .forEach(button =>
        button.addEventListener("click", () => {
          week = Math.max(1, week + Number(button.dataset.week));
          renderWeek();
        })
      );

    render();
    load();
  }
</script>

<style is:global>
  .uren-empty {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .uren-empty[hidden] {
    display: none;
  }

  /* ---- now */
  .people {
    display: grid;
    gap: var(--space-xs);
    margin-bottom: var(--space-l);
  }
  @media (min-width: 40rem) {
    .people {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .person {
    padding: var(--space-xs);
    border: 1px solid var(--line);
    border-radius: 16px;
    background-color: var(--card);
  }
  .person__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .person__head img {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    object-fit: cover;
  }
  .person__light {
    width: 0.55rem;
    height: 0.55rem;
    margin-left: auto;
    border-radius: 999px;
    background-color: var(--line);
  }
  .person__clock {
    margin-top: var(--space-xs);
    font-size: var(--fs-xl);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    color: var(--muted);
  }
  .person__line {
    font-size: var(--fs-sm);
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .person--on {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .person--on .person__light {
    background-color: var(--blue);
    box-shadow: 0 0 0 3px var(--today-ring);
  }
  .person--on .person__clock {
    color: var(--ink);
  }

  /* ---- week */
  .week {
    display: grid;
    grid-template-columns: 8rem repeat(7, minmax(3rem, 1fr)) 4.5rem;
    gap: 0.35rem;
    min-width: 36rem;
    padding: var(--space-xs);
    font-size: var(--fs-sm);
  }
  .week__day {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: 0.35rem;
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.2;
  }
  .week__day strong {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink);
  }
  .week__day.is-today strong {
    padding: 0 0.35rem;
    border-radius: 999px;
    background-color: var(--today);
  }
  .week__total-head {
    justify-content: flex-end;
  }
  .week__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .week__name img {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 999px;
    object-fit: cover;
  }
  .week__cell {
    display: grid;
    place-items: center;
    height: 2.5rem;
    border-radius: 8px;
    background-color: rgba(35, 35, 35, var(--strength, 0));
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .week__cell.is-dark {
    color: var(--card);
  }
  .week__cell.is-today {
    box-shadow: inset 0 0 0 2px var(--today-ring);
  }
  .week__total {
    align-self: center;
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* ---- sessions */
  .uren-bar {
    margin-top: 0;
  }
  .uren-title {
    margin: var(--space-l) 0 var(--space-xs);
    font-size: var(--fs-base);
    font-weight: 600;
  }
  .sessions li {
    display: grid;
    grid-template-columns: 9rem 5rem 1fr 3.5rem;
    gap: 1rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .sessions li:last-child {
    border-bottom: 0;
  }
  .sessions__when,
  .sessions__length {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .sessions__who {
    font-weight: 600;
  }
  .sessions__what {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .sessions__length {
    text-align: right;
  }
  .sessions__empty {
    color: var(--muted);
  }
  @media (max-width: 40rem) {
    .sessions li {
      grid-template-columns: 1fr auto;
    }
    .sessions__when {
      grid-column: 1 / -1;
    }
  }
</style>
