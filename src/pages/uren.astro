---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE, SUPABASE } from "@config";
import team from "../data/team.json";

const ready = Boolean(SUPABASE.url && SUPABASE.key);
---

<Layout title={`Uren | ${SITE.title}`}>
  <Header activeNav="uren" />
  <main id="main-content" class="page">
    <div class="page-head">
      <h2 class="page-title">Uren</h2>
      <a
        href="https://track.toggl.com/timer"
        target="_blank"
        rel="noopener"
        class="quiet-link">Open Toggl</a
      >
    </div>

    <p class="intro">
      Iedereen houdt zijn uren bij in zijn eigen Toggl, in het project
      <strong>BAP</strong>. Start je timer daar: hier zie je live wie aan het
      werk is, en de uren per dag tellen vanzelf op.
    </p>

    {
      !ready ? (
        <p class="empty">
          De urenregistratie is nog niet gekoppeld aan Supabase. Zie de README.
        </p>
      ) : (
        <>
          <p class="message" data-message hidden />

          <section class="block">
            <h3 class="block-title">Nu</h3>
            <div class="people">
              {team.map(({ naam }) => (
                <div class="person" data-person={naam}>
                  <div class="person__top">
                    <span class="light" aria-hidden="true" />
                    <strong>{naam}</strong>
                    <span class="state" data-state>
                      …
                    </span>
                  </div>
                  <p class="clock" data-clock>
                    0:00:00
                  </p>
                  <p class="today" data-today />
                </div>
              ))}
            </div>
          </section>

          <section class="block">
            <div class="week-switch">
              <button
                type="button"
                class="quiet-link"
                data-week="-1"
                aria-label="Vorige week"
              >
                ←
              </button>
              <h3 class="block-title" data-week-title />
              <button
                type="button"
                class="quiet-link"
                data-week="1"
                aria-label="Volgende week"
              >
                →
              </button>
            </div>
            <div class="table-wrap">
              <table class="hours">
                <thead>
                  <tr>
                    <th>Dag</th>
                    {team.map(({ naam }) => (
                      <th>{naam}</th>
                    ))}
                  </tr>
                </thead>
                <tbody data-days />
                <tfoot data-totals />
              </table>
            </div>
            <p class="total" data-grand-total />
          </section>

          <section class="block">
            <h3 class="block-title">Laatste sessies</h3>
            <ul class="sessions" data-sessions />
          </section>
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  import { createClient } from "@supabase/supabase-js";
  import { SUPABASE } from "@config";

  type Timer = { wie: string; sinds: string; wat: string };
  type Sessie = {
    id: string;
    wie: string;
    van: string;
    tot: string;
    wat: string;
  };

  const root = document.querySelector<HTMLElement>("[data-days]");
  if (root && SUPABASE.url && SUPABASE.key) {
    const db = createClient(SUPABASE.url, SUPABASE.key);
    const $ = <T extends HTMLElement>(selector: string) =>
      document.querySelector<T>(selector)!;
    const people = [...document.querySelectorAll<HTMLElement>("[data-person]")];
    const names = people.map(p => p.dataset.person!);

    let timers: Timer[] = [];
    let sessies: Sessie[] = [];

    // ---- time helpers
    const HOUR = 3600_000;
    const DAY = 24 * HOUR;
    const pad = (n: number) => String(n).padStart(2, "0");
    const dayKey = (time: number | string) => {
      const d = new Date(time);
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    };
    const length = (s: { van: string; tot: string }) =>
      Date.parse(s.tot) - Date.parse(s.van);
    const clock = (ms: number) => {
      const s = Math.max(0, Math.floor(ms / 1000));
      return `${Math.floor(s / 3600)}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;
    };
    // 5412000 -> "1:30:12", exact to the second, never rounded
    const hours = (ms: number) => (Math.floor(ms / 1000) > 0 ? clock(ms) : "–");
    const time = (iso: string) =>
      new Date(iso).toLocaleTimeString("nl-BE", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      });
    const dayLabel = (key: string, options: Intl.DateTimeFormatOptions) =>
      new Date(`${key}T12:00:00`).toLocaleDateString("nl-BE", options);

    // Week 1 of the bachelor project starts on Monday 26 October 2026.
    const START = new Date(2026, 9, 26).getTime();
    const weekOf = (t: number) => Math.floor((t - START) / (7 * DAY)) + 1;
    let week = Math.max(1, weekOf(Date.now()));

    // Time worked on one day by one person, including a timer that is running now.
    function worked(person: string, key: string, now: number) {
      let total = sessies
        .filter(s => s.wie === person && dayKey(s.van) === key)
        .reduce((sum, s) => sum + length(s), 0);
      const timer = timers.find(t => t.wie === person);
      if (timer && dayKey(timer.sinds) === key)
        total += now - Date.parse(timer.sinds);
      return total;
    }

    const cell = (tag: "th" | "td", text: string) => {
      const el = document.createElement(tag);
      el.textContent = text;
      return el;
    };

    // ---- drawing
    function renderPeople() {
      const now = Date.now();
      for (const card of people) {
        const person = card.dataset.person!;
        const timer = timers.find(t => t.wie === person);
        card.classList.toggle("person--on", Boolean(timer));
        card.querySelector("[data-state]")!.textContent = timer
          ? `werkt sinds ${time(timer.sinds)}${timer.wat ? ` · ${timer.wat}` : ""}`
          : "niet aan het werk";
        card.querySelector("[data-clock]")!.textContent = timer
          ? clock(now - Date.parse(timer.sinds))
          : "0:00:00";
        card.querySelector("[data-today]")!.textContent =
          `vandaag ${hours(worked(person, dayKey(now), now))}`;
      }
    }

    function renderWeek() {
      const now = Date.now();
      const monday = START + (week - 1) * 7 * DAY;
      const days = Array.from({ length: 7 }, (_, i) =>
        dayKey(monday + i * DAY + 12 * HOUR)
      );
      const short = { day: "numeric", month: "short" } as const;
      $("[data-week-title]").textContent =
        `Week ${week} · ${dayLabel(days[0], short)} – ${dayLabel(days[6], short)}`;

      root!.replaceChildren(
        ...days.map(key => {
          const tr = document.createElement("tr");
          if (key === dayKey(now)) tr.className = "is-today";
          tr.append(
            cell("th", dayLabel(key, { weekday: "short", ...short })),
            ...names.map(person => cell("td", hours(worked(person, key, now))))
          );
          return tr;
        })
      );

      const totals = document.createElement("tr");
      totals.append(
        cell("th", "Totaal"),
        ...names.map(person =>
          cell(
            "td",
            hours(days.reduce((sum, key) => sum + worked(person, key, now), 0))
          )
        )
      );
      $("[data-totals]").replaceChildren(totals);

      $("[data-grand-total]").textContent = `Sinds de start: ${names
        .map(person => {
          const done = sessies
            .filter(s => s.wie === person)
            .reduce((sum, s) => sum + length(s), 0);
          const running = timers
            .filter(t => t.wie === person)
            .reduce((sum, t) => sum + now - Date.parse(t.sinds), 0);
          return `${person} ${hours(done + running)}`;
        })
        .join(" · ")}`;
    }

    function renderSessions() {
      const items = [...sessies]
        .sort((a, b) => b.van.localeCompare(a.van))
        .slice(0, 15)
        .map(s => {
          const li = document.createElement("li");
          const span = (className: string, text: string) => {
            const el = document.createElement("span");
            el.className = className;
            el.textContent = text;
            return el;
          };
          const day = dayLabel(dayKey(s.van), {
            weekday: "short",
            day: "numeric",
            month: "short",
          });
          li.append(
            span("sessions__when", `${day} · ${time(s.van)}–${time(s.tot)}`),
            span("sessions__who", s.wie),
            span("sessions__what", s.wat || "—"),
            span("sessions__length", hours(length(s)))
          );
          return li;
        });
      if (!items.length) {
        const li = document.createElement("li");
        li.className = "empty";
        li.textContent = "Nog geen uren.";
        items.push(li);
      }
      $("[data-sessions]").replaceChildren(...items);
    }

    function render() {
      renderPeople();
      renderWeek();
      renderSessions();
    }

    // ---- data
    async function load() {
      const [t, s] = await Promise.all([
        db.from("timers").select("wie, sinds, wat"),
        db.from("sessies").select("id, wie, van, tot, wat").order("van"),
      ]);
      const message = $("[data-message]");
      message.hidden = !(t.error || s.error);
      message.textContent = "De uren konden niet geladen worden.";
      if (t.error || s.error) return;
      timers = t.data as Timer[];
      sessies = s.data as Sessie[];
      render();
    }

    // Live: reload whenever Toggl reports a change.
    db.channel("uren")
      .on(
        "postgres_changes",
        { event: "*", schema: "public", table: "timers" },
        load
      )
      .on(
        "postgres_changes",
        { event: "*", schema: "public", table: "sessies" },
        load
      )
      .subscribe();
    // The clocks of running timers count every second.
    setInterval(() => {
      if (timers.length) {
        renderPeople();
        renderWeek();
      }
    }, 1000);

    document
      .querySelectorAll<HTMLButtonElement>("[data-week]")
      .forEach(button =>
        button.addEventListener("click", () => {
          week = Math.max(1, week + Number(button.dataset.week));
          renderWeek();
        })
      );

    render();
    load();
  }
</script>

<style>
  .intro {
    max-width: 40rem;
    margin-bottom: var(--space-m);
    color: var(--muted);
  }
  .intro strong {
    color: var(--ink);
  }
  .empty {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .message {
    margin-bottom: var(--space-s);
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--blue);
    border-radius: 8px;
    background-color: var(--card);
    font-size: var(--fs-sm);
  }
  .block {
    margin-bottom: var(--space-l);
  }
  .block-title {
    margin-bottom: 0.75rem;
    font-size: var(--fs-md);
    font-weight: 700;
  }
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
  }
  .person {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background-color: var(--card);
  }
  .person--on {
    border: 2px solid var(--blue);
  }
  .person__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .light {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background-color: var(--line);
  }
  .person--on .light {
    background-color: #10b981;
  }
  .state {
    flex-basis: 100%;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .clock {
    font-size: var(--fs-xl);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .person:not(.person--on) .clock {
    color: var(--muted);
  }
  .today {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .week-switch {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .week-switch .block-title {
    margin: 0;
  }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background-color: var(--card);
  }
  .hours {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
  .hours :global(td),
  .hours :global(th) {
    padding: 0.55rem 1rem;
    text-align: right;
    white-space: nowrap;
  }
  .hours :global(th:first-child) {
    text-align: left;
    font-weight: 500;
    color: var(--muted);
  }
  .hours thead :global(th) {
    border-bottom: 1px solid var(--line);
    font-weight: 700;
    color: var(--ink);
  }
  .hours :global(tbody tr + tr) {
    border-top: 1px solid var(--line);
  }
  .hours :global(tr.is-today) {
    background-color: var(--paper);
  }
  .hours :global(tr.is-today th) {
    font-weight: 700;
    color: var(--blue);
  }
  .hours :global(tfoot tr) {
    border-top: 2px solid var(--line);
    font-weight: 700;
  }
  .total {
    margin-top: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .sessions {
    display: flex;
    flex-direction: column;
  }
  .sessions :global(li) {
    display: grid;
    grid-template-columns: 12rem 5rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .sessions :global(li:first-child) {
    border-top: 0;
  }
  .sessions :global(.sessions__who) {
    font-weight: 700;
  }
  .sessions :global(.sessions__when),
  .sessions :global(.sessions__length) {
    color: var(--muted);
    white-space: nowrap;
  }
  @media (max-width: 40rem) {
    .sessions :global(li) {
      grid-template-columns: 1fr auto;
      row-gap: 0.1rem;
    }
    .sessions :global(.sessions__when) {
      grid-column: 1 / -1;
    }
  }
</style>
