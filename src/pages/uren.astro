---
import AboutLayout from "@layouts/AboutLayout.astro";
import { bapWeek } from "@utils/pijlers";
import urenData from "../data/uren.json";

// uren.json starts empty, so give TypeScript the shape Pages CMS writes.
type Uren = {
  datum: string;
  ibe: number;
  tjorven: number;
  senne: number;
  wat?: string;
};
const uren = urenData as Uren[];

const people = [
  ["ibe", "Ibe"],
  ["tjorven", "Tjorven"],
  ["senne", "Senne"],
] as const;

const rows = [...uren].sort((a, b) => b.datum.localeCompare(a.datum));
const total = (key: "ibe" | "tjorven" | "senne") =>
  uren.reduce((sum, row) => sum + (Number(row[key]) || 0), 0);
const date = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("nl-BE", {
    weekday: "short",
    day: "numeric",
    month: "short",
    timeZone: "UTC",
  });

// Hours per BAP week, for the small overview above the table.
const weeks = new Map<number, number>();
for (const row of uren) {
  const week = bapWeek(new Date(`${row.datum}T00:00:00Z`));
  const sum = people.reduce((s, [key]) => s + (Number(row[key]) || 0), 0);
  weeks.set(week, (weeks.get(week) ?? 0) + sum);
}
const weekList = [...weeks].sort(([a], [b]) => a - b);
const maxWeek = Math.max(1, ...weeks.values());
const base = import.meta.env.BASE_URL;
---

<AboutLayout frontmatter={{ title: "Uren", nav: "uren" }}>
  <div slot="before" class="mb-4 grid gap-4 sm:grid-cols-3">
    {
      people.map(([key, name]) => (
        <div class="panel flex items-center gap-4">
          <img
            src={`${base}stickers/${key}.png`}
            alt=""
            width="313"
            height="360"
            class="h-12 w-auto"
          />
          <div>
            <p class="text-sm opacity-60">{name}</p>
            <p class="text-2xl font-semibold tabular-nums">{total(key)} u</p>
          </div>
        </div>
      ))
    }
    {
      weekList.length > 0 && (
        <div class="panel sm:col-span-3">
          <p class="panel-title">Per week (samen)</p>
          <ul class="flex flex-col gap-2">
            {weekList.map(([week, sum]) => (
              <li class="grid grid-cols-[5rem_1fr_3rem] items-center gap-3 text-sm">
                <span class="opacity-60">Week {week}</span>
                <span class="h-1.5 overflow-hidden rounded-full bg-skin-card">
                  <span
                    class="block h-full rounded-full bg-skin-inverted opacity-70"
                    style={`width: ${(sum / maxWeek) * 100}%`}
                  />
                </span>
                <span class="text-right tabular-nums">{sum} u</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  {
    rows.length === 0 ? (
      <p class="!my-0 opacity-60">
        Nog geen uren geregistreerd. Voeg ze toe via Beheer → Uren.
      </p>
    ) : (
      <table class="!my-0">
        <thead>
          <tr>
            <th>Datum</th>
            <th>Ibe</th>
            <th>Tjorven</th>
            <th>Senne</th>
            <th>Wat</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(row => (
            <tr>
              <td class="whitespace-nowrap">{date(row.datum)}</td>
              <td>{row.ibe}</td>
              <td>{row.tjorven}</td>
              <td>{row.senne}</td>
              <td>{row.wat}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
</AboutLayout>
