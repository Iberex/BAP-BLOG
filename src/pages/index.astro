---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import getSortedPosts from "@utils/getSortedPosts";
import home from "../data/home.json";

const base = import.meta.env.BASE_URL;
const latest = getSortedPosts(await getCollection("blog")).slice(0, 3);
---

<Layout>
  <Header />
  <main id="main-content">
    <div class="hero">
      <div>
        <h1 class="hero__title">{home.titel}</h1>
        {home.vraag && <p class="hero__subtitle">{home.vraag}</p>}
      </div>
    </div>

    <div class="page">
      <section class="block">
        <div class="section-head">
          <h2>Laatste posts</h2>
          <a href={`${base}posts/`} class="link-arrow">alle posts →</a>
        </div>
        <ul class="list">
          {
            latest.map(({ data, slug }) => (
              <Card href={`${base}posts/${slug}/`} frontmatter={data} />
            ))
          }
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
