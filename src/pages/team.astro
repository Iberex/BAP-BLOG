---
import AboutLayout from "@layouts/AboutLayout.astro";
import team from "../data/team.json";

const base = import.meta.env.BASE_URL;
---

<AboutLayout frontmatter={{ title: "Team", nav: "team" }}>
  <div slot="before" class="team">
    {
      team.map(member => (
        <article class="member">
          <img
            src={`${base}team/${member.naam.toLowerCase()}.jpg`}
            alt={`Foto van ${member.naam}`}
            width="400"
            height="400"
            class="member__photo"
          />
          <h3 class="member__name">{member.naam}</h3>
          <p class="member__role">{member.rol}</p>
        </article>
      ))
    }
  </div>
</AboutLayout>

<style>
  .team {
    display: grid;
    gap: var(--space-m);
    margin-bottom: var(--space-m);
  }
  @media (min-width: 40rem) {
    .team {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  /* Every member in a photo frame, like a print on the paper. */
  .member {
    padding: 0.6rem 0.6rem var(--space-xs);
    border: 1px solid var(--line);
    border-radius: 16px;
    background-color: #fff;
    box-shadow: 0 8px 24px rgba(35, 35, 35, 0.07);
  }
  .member__photo {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 10px;
  }
  .member__name {
    margin-top: var(--space-xs);
    padding: 0 0.4rem;
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .member__role {
    padding: 0 0.4rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--muted);
  }
</style>
