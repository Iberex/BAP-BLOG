---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@config";
import { bapWeek, weekRange } from "@utils/pijlers";

type Item = {
  id: string;
  t: string;
  type: string;
  ond: string;
  start: string;
  end?: string;
  status: string;
  wie?: string;
};

const SOURCE =
  "https://raw.githubusercontent.com/senne-debacker/BAP-PLANNING/main/tasks.json";

let items: Item[] = [];
let failed = false;
try {
  const response = await fetch(SOURCE);
  items = ((await response.json()) as Item[]).filter(i => i.t && i.start);
} catch {
  failed = true;
}

// The columns of a day, like the pillars. Every "onderdeel" of the planning goes in one of them.
const COLUMNS = [
  { key: "design", label: "Design", ond: ["Design"] },
  { key: "ux", label: "UX", ond: ["Experience Design", "Testen"] },
  { key: "dev", label: "Development", ond: ["Development", "Bouw"] },
  { key: "algemeen", label: "Communicatie", ond: ["Communicatie", ""] },
];
const column = (ond: string) =>
  COLUMNS.find(c => c.ond.includes(ond)) ?? COLUMNS[3];

const DAY = 24 * 60 * 60 * 1000;
const noon = (iso: string) => new Date(`${iso}T12:00:00Z`);
const iso = (date: Date) => date.toISOString().slice(0, 10);
const format = (date: string, options: Intl.DateTimeFormatOptions) =>
  noon(date).toLocaleDateString("nl-BE", { timeZone: "UTC", ...options });
const done = (item: Item) => /done/i.test(item.status);
const busy = (item: Item) => /in works/i.test(item.status);
const people = (item: Item) =>
  (item.wie ?? "")
    .split(/[,&]| en /)
    .map(name => name.trim())
    .filter(Boolean);

// A task is shown on its first day, and again on the Monday of every next week it still runs.
const days = new Map<string, Item[]>();
const add = (date: string, item: Item) =>
  days.set(date, [...(days.get(date) ?? []), item]);
for (const item of items) {
  add(item.start, item);
  if (item.type !== "Taak" || !item.end) continue;
  for (
    let t = noon(item.start).getTime() + DAY;
    t <= noon(item.end).getTime();
    t += DAY
  ) {
    if (new Date(t).getUTCDay() === 1) add(iso(new Date(t)), item);
  }
}

const today = iso(new Date());
const thisWeek = bapWeek(noon(today));
if (!days.has(today)) days.set(today, []);

const weeks = new Map<number, string[]>();
for (const date of [...days.keys()].sort()) {
  const week = bapWeek(noon(date));
  weeks.set(week, [...(weeks.get(week) ?? []), date]);
}
const plan = [...weeks].map(([week, dates]) => ({
  week,
  past: week < thisWeek,
  days: dates.map(date => {
    const list = days.get(date)!;
    const tasks = list.filter(i => i.type === "Taak");
    return {
      date,
      today: date === today,
      moments: list.filter(i => i.type !== "Taak"),
      columns: COLUMNS.map((c, index) => ({
        ...c,
        place: index + 1,
        tasks: tasks.filter(t => column(t.ond).key === c.key),
      })).filter(c => c.tasks.length > 0),
    };
  }),
}));
---

<Layout title={`Planning | ${SITE.title}`}>
  <Header activeNav="planning" />
  <main id="main-content" class="page">
    <div class="page-head">
      <h2 class="page-title">Planning</h2>
      <a
        href="https://senne-debacker.github.io/BAP-PLANNING/"
        target="_blank"
        rel="noopener"
        class="quiet-link">+ planning bewerken</a
      >
    </div>

    {
      failed ? (
        <p class="empty">De planning kon niet geladen worden.</p>
      ) : (
        <>
          <ul class="legend" aria-label="Kolommen">
            {COLUMNS.map(c => (
              <li class={`pill pill-${c.key}`}>{c.label}</li>
            ))}
          </ul>

          {plan.map(({ week, past, days }) => (
            <details class="week" open={!past}>
              <summary>
                <span class="week__title">Week {week}</span>
                <span class="week__range">{weekRange(week)}</span>
              </summary>

              <div class="days">
                {days.map(day => (
                  <article class:list={["day", { "day--today": day.today }]}>
                    <p class="day__date">
                      <span>{format(day.date, { weekday: "short" })}</span>
                      <strong>{format(day.date, { day: "numeric" })}</strong>
                      <span>{format(day.date, { month: "short" })}</span>
                    </p>

                    <div class="day__body">
                      {day.today && <span class="today">vandaag</span>}
                      {day.moments.map(item => (
                        <p class="moment">
                          <span class="moment__type">{item.type}</span>
                          <strong>{item.t}</strong>
                        </p>
                      ))}
                      {day.columns.length > 0 && (
                        <div class="columns">
                          {day.columns.map(c => (
                            <div
                              class={`column pill-${c.key}`}
                              style={`--place: ${c.place}`}
                            >
                              <h3>{c.label}</h3>
                              <ul>
                                {c.tasks.map(task => (
                                  <li
                                    class:list={[
                                      "task",
                                      { "task--done": done(task) },
                                    ]}
                                  >
                                    <span
                                      class:list={[
                                        "check",
                                        { "check--busy": busy(task) },
                                      ]}
                                      aria-label={
                                        done(task)
                                          ? "Klaar"
                                          : busy(task)
                                            ? "Bezig"
                                            : "Te doen"
                                      }
                                    />
                                    <span class="task__text">
                                      {task.t}
                                      {task.end && task.end !== task.start && (
                                        <span class="task__until">
                                          t/m{" "}
                                          {format(task.end, {
                                            day: "numeric",
                                            month: "short",
                                          })}
                                        </span>
                                      )}
                                      {people(task).length > 0 && (
                                        <span class="task__people">
                                          {people(task).map(name => (
                                            <span class="person">{name}</span>
                                          ))}
                                        </span>
                                      )}
                                    </span>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          ))}
                        </div>
                      )}
                      {day.moments.length === 0 && day.columns.length === 0 && (
                        <p class="empty">Niets gepland.</p>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </details>
          ))}
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .empty {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--space-m);
  }
  .week {
    margin-bottom: 0.5rem;
  }
  .week[open] {
    margin-bottom: var(--space-m);
  }
  .week summary {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    cursor: pointer;
    list-style: none;
  }
  .week summary::-webkit-details-marker {
    display: none;
  }
  .week summary::before {
    content: "▸";
    color: var(--muted);
  }
  .week[open] summary::before {
    content: "▾";
  }
  .week__title {
    font-size: var(--fs-lg);
    font-weight: 800;
  }
  .week__range {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .days {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .day {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background-color: var(--card);
  }
  .day--today {
    border: 2px solid var(--blue);
  }
  .day__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .day__date strong {
    font-size: 1.75rem;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--ink);
  }
  .day--today .day__date strong {
    color: var(--blue);
  }
  .day__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    min-width: 0;
  }
  .today {
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    background-color: var(--blue);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .moment {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }
  .moment__type {
    padding: 0.05rem 0.45rem;
    border-radius: 6px;
    background-color: var(--paper);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }
  /* Every pillar has its own place, so Design is always left and Communicatie right. */
  .columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
  }
  @media (min-width: 40.01rem) {
    .column {
      grid-column: var(--place);
    }
  }
  .column {
    padding-left: 0.75rem;
    border-left: 3px solid rgb(var(--pill, var(--color-algemeen)));
  }
  .column h3 {
    margin-bottom: 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .column ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .task {
    display: flex;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    line-height: 1.4;
  }
  .check {
    flex-shrink: 0;
    width: 0.9rem;
    height: 0.9rem;
    margin-top: 0.15rem;
    border: 1.5px solid var(--muted);
    border-radius: 4px;
  }
  .check--busy {
    border-color: var(--blue);
    background: linear-gradient(90deg, var(--blue) 50%, transparent 50%);
  }
  .task--done .check {
    border-color: var(--muted);
    background-color: var(--muted);
  }
  .task--done .task__text {
    text-decoration: line-through;
    color: var(--muted);
  }
  .task__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }
  .task__until {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .task__people {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .person {
    padding: 0 0.4rem;
    border-radius: 999px;
    background-color: var(--blue);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
  }
  @media (max-width: 40rem) {
    .columns {
      grid-template-columns: 1fr;
    }
    .day {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .day__date {
      flex-direction: row;
      gap: 0.4rem;
      align-items: baseline;
    }
    .day__date strong {
      font-size: 1.25rem;
    }
  }
</style>
