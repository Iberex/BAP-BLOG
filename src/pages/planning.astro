---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@config";
import { bapWeek, weekRange } from "@utils/pijlers";
import { slugifyStr } from "@utils/slugify";

type Item = {
  id: string;
  t: string;
  type: string;
  ond: string;
  start: string;
  end?: string;
  status: string;
};

const SOURCE =
  "https://raw.githubusercontent.com/senne-debacker/BAP-PLANNING/main/tasks.json";

let items: Item[] = [];
let failed = false;
try {
  const response = await fetch(SOURCE);
  items = ((await response.json()) as Item[]).filter(i => i.t && i.start);
} catch {
  failed = true;
}

const noon = (iso: string) => new Date(`${iso}T12:00:00Z`);
const day = (iso: string) =>
  noon(iso).toLocaleDateString("nl-BE", { day: "numeric", month: "short" });
const range = (item: Item) =>
  item.end && item.end !== item.start
    ? `${day(item.start)} – ${day(item.end)}`
    : day(item.start);
const status = (value: string) =>
  /done/i.test(value) ? "done" : /not started/i.test(value) ? "todo" : "busy";
const STATUS = { todo: "Te doen", busy: "Bezig", done: "Klaar" };

const now = bapWeek(new Date());
const weeks = new Map<number, Item[]>();
for (const item of items) {
  const first = bapWeek(noon(item.start));
  const last = bapWeek(noon(item.end || item.start));
  for (let week = first; week <= last; week++) {
    weeks.set(week, [...(weeks.get(week) ?? []), item]);
  }
}
const sorted = [...weeks]
  .sort(([a], [b]) => a - b)
  .map(([week, list]) => {
    const byDate = [...list].sort((a, b) => a.start.localeCompare(b.start));
    return {
      week,
      moments: byDate.filter(i => i.type !== "Taak"),
      tasks: byDate.filter(i => i.type === "Taak"),
    };
  });

const unique = (values: string[]) => [...new Set(values.filter(Boolean))];
const onderdelen = unique(items.map(i => i.ond)).sort();
const attrs = (item: Item) => ({ "data-ond": slugifyStr(item.ond) });
---

<Layout title={`Planning | ${SITE.title}`}>
  <Header activeNav="planning" />
  <main id="main-content" class="page">
    <div class="plan-head">
      <h2 class="page-title">Planning</h2>
      <a
        href="https://senne-debacker.github.io/BAP-PLANNING/"
        target="_blank"
        rel="noopener"
        class="link-arrow">planning bewerken →</a
      >
    </div>

    {
      failed ? (
        <p class="empty">De planning kon niet geladen worden.</p>
      ) : (
        <>
          <div class="filter-row plan-filter" data-filter="ond">
            <button class="chip" aria-pressed="true" data-value="">
              Alles
            </button>
            {onderdelen.map(ond => (
              <button
                class="chip"
                aria-pressed="false"
                data-value={slugifyStr(ond)}
              >
                {ond}
              </button>
            ))}
          </div>

          <div class="plan-weeks">
            {sorted.map(({ week, moments, tasks }) => (
              <details
                class:list={["plan-week", { "plan-week--now": week === now }]}
                open={week === now}
                data-now={week === now ? "" : undefined}
              >
                <summary>
                  <span class="plan-week__title">
                    Week {week}
                    {week === now && <span class="now">deze week</span>}
                  </span>
                  <span class="plan-week__range">{weekRange(week)}</span>
                  <svg viewBox="0 0 24 24" class="chevron" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>

                <div class="plan-week__body">
                  {moments.length > 0 && (
                    <ul class="moments">
                      {moments.map(item => (
                        <li
                          class={`moment moment--${slugifyStr(item.type)}`}
                          {...attrs(item)}
                        >
                          <span class="moment-date">{day(item.start)}</span>
                          <span class="moment-title">{item.t}</span>
                          <span class="moment-type">{item.type}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {tasks.length > 0 && (
                    <ul class="tasks">
                      {tasks.map(item => (
                        <li class="task" {...attrs(item)}>
                          <span
                            class={`dot dot--${status(item.status)}`}
                            title={STATUS[status(item.status)]}
                          />
                          <span class="task-title">{item.t}</span>
                          <span class="task-ond">{item.ond}</span>
                          <span class="task-date">{range(item)}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </details>
            ))}
          </div>
          <p id="plan-empty" class="empty" hidden>
            Geen items met deze filters.
          </p>
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .plan-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .empty {
    color: var(--muted);
  }
  .plan-filter {
    margin-bottom: var(--space-m);
    font-size: var(--fs-base);
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .plan-weeks {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .plan-week {
    border: 1px solid var(--line);
    border-radius: 12px;
    background-color: var(--card);
  }
  .plan-week--now {
    border-color: var(--blue);
  }
  .plan-week summary {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }
  .plan-week summary::-webkit-details-marker {
    display: none;
  }
  .plan-week__title {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-weight: 700;
  }
  .plan-week__range {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .now {
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    background-color: var(--blue);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .chevron {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .plan-week[open] .chevron {
    transform: rotate(180deg);
  }
  .plan-week__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 1.25rem 1.25rem;
  }
  .moments,
  .tasks {
    display: flex;
    flex-direction: column;
  }
  .moments {
    gap: 0.4rem;
  }
  .moment {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0.75rem;
    border-left: 3px solid var(--line);
    border-radius: 0 8px 8px 0;
    background-color: var(--paper);
    font-size: var(--fs-base);
  }
  .moment--school-deadline {
    border-left-color: #e11d48;
  }
  .moment--tussendeadline {
    border-left-color: #f59e0b;
  }
  .moment--overleg {
    border-left-color: var(--blue);
  }
  .moment-date {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--muted);
  }
  .moment-title {
    font-weight: 600;
  }
  .moment-type {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .task {
    display: grid;
    grid-template-columns: 0.6rem 1fr 9rem 8rem;
    gap: 0.75rem;
    align-items: center;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
    font-size: var(--fs-base);
  }
  .task:first-child {
    border-top: 0;
  }
  .task-ond,
  .task-date {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .task-date {
    text-align: right;
    white-space: nowrap;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    flex-shrink: 0;
    border-radius: 999px;
    background-color: var(--line);
  }
  .dot--busy {
    background-color: var(--blue);
  }
  .dot--done {
    background-color: #10b981;
  }
  @media (max-width: 40rem) {
    .plan-week summary {
      grid-template-columns: 1fr auto;
    }
    .plan-week__range {
      grid-column: 1;
      grid-row: 2;
    }
    .chevron {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .moment {
      grid-template-columns: 4rem 1fr;
    }
    .moment-type {
      display: none;
    }
    .task {
      grid-template-columns: 0.6rem 1fr auto;
      row-gap: 0.1rem;
    }
    .task-title {
      grid-column: 2 / span 2;
    }
    .task-ond {
      grid-column: 2;
    }
    .task-date {
      grid-column: 3;
    }
  }
</style>

<script>
  const filters: Record<string, string> = { ond: "" };
  const rows = document.querySelectorAll<HTMLElement>("[data-ond]");
  const weeks = document.querySelectorAll<HTMLDetailsElement>(".plan-week");

  function apply() {
    const active = Object.values(filters).some(Boolean);
    rows.forEach(row => {
      row.hidden = Object.entries(filters).some(
        ([key, value]) => value && row.dataset[key] !== value
      );
    });
    let shown = 0;
    weeks.forEach(week => {
      const visible = week.querySelectorAll("[data-ond]:not([hidden])").length;
      week.hidden = visible === 0;
      week.open = active ? visible > 0 : week.hasAttribute("data-now");
      week.querySelectorAll<HTMLElement>(".moments, .tasks").forEach(list => {
        list.hidden = !list.querySelector("[data-ond]:not([hidden])");
      });
      if (visible) shown++;
    });
    document.getElementById("plan-empty")!.hidden = shown > 0;
  }

  document.querySelectorAll<HTMLElement>("[data-filter]").forEach(row =>
    row.addEventListener("click", event => {
      const button = (event.target as HTMLElement).closest("button");
      if (!button) return;
      filters[row.dataset.filter!] = button.dataset.value ?? "";
      row
        .querySelectorAll("button")
        .forEach(b => b.setAttribute("aria-pressed", String(b === button)));
      apply();
    })
  );
</script>
