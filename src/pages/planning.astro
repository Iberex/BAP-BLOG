---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE, SUPABASE } from "@config";
import { Icon } from "astro-icon/components";
import lucide from "@iconify-json/lucide/icons.json";

// Lucide icons per kind of work, handed to the script below.
const ICON_NAMES: Record<string, string> = {
  Development: "code-xml",
  Design: "palette",
  UX: "layout-template",
  Algemeen: "pin",
  Deadline: "flag",
  Overleg: "message-circle",
  pencil: "pencil",
  check: "check",
  link: "link",
  star: "star",
};
const iconBodies = Object.fromEntries(
  Object.entries(ICON_NAMES).map(([key, name]) => [
    key,
    lucide.icons[name as keyof typeof lucide.icons].body,
  ])
);

// Snapshot of the planning at build time: shown at once on a first visit,
// until the live data has loaded.
let snapshot = "[]";
try {
  const res = await fetch(
    `${SUPABASE.url}/rest/v1/planning?select=*&order=van`,
    {
      headers: {
        apikey: SUPABASE.key,
        Authorization: `Bearer ${SUPABASE.key}`,
      },
    }
  );
  if (res.ok) snapshot = JSON.stringify(await res.json());
} catch {}
---

<Layout title={`Planning | ${SITE.title}`}>
  <Header activeNav="planning" />
  <main id="main-content" class="page planner">
    <h2 class="page-title">Planning</h2>
    <div hidden data-icons={JSON.stringify(iconBodies)}></div>
    <div hidden data-snapshot={snapshot}></div>

    <!-- One bar: other weeks on the left, view and editing on the right. -->
    <div class="planner-bar">
      <div class="weeks-nav" data-weeks-nav>
        <button
          type="button"
          class="arrow"
          data-step="-7"
          aria-label="Vorige week">‹</button
        >
        <button
          type="button"
          class="range"
          data-range
          title="Terug naar deze week"></button>
        <button
          type="button"
          class="arrow"
          data-step="7"
          aria-label="Volgende week">›</button
        >
      </div>
      <div class="planner-bar__right">
        <div class="switch" role="group" aria-label="Zoom" data-zoom-switch>
          <button type="button" data-zoom="7">1 week</button>
          <button type="button" data-zoom="21">3 weken</button>
        </div>
        <div class="switch" role="group" aria-label="Weergave">
          <button type="button" data-view="tijdlijn">Tijdlijn</button>
          <button type="button" data-view="lijst">Lijst</button>
        </div>
        <button type="button" class="btn" data-new hidden>+ Taak</button>
        <button type="button" class="btn" data-edit
          ><Icon name="lucide:pencil" /> Bewerken</button
        >
      </div>
    </div>

    <!-- Personal code: only the team can change the planning. -->
    <form class="panel" data-code-form hidden>
      <label class="field">
        Jouw code
        <input type="password" name="code" autocomplete="off" required />
      </label>
      <button type="submit" class="btn btn--primary">OK</button>
      <span class="error" data-code-error></span>
    </form>

    <!-- New task. -->
    <form class="panel" data-add hidden>
      <div class="panel__line">
        <input
          class="grow"
          name="taak"
          placeholder="Wat moet er gebeuren?"
          required
        />
        <span class="who">
          <label><input type="checkbox" name="wie" value="Senne" /> Senne</label
          >
          <label
            ><input type="checkbox" name="wie" value="Tjorven" /> Tjorven</label
          >
          <label><input type="checkbox" name="wie" value="Ibe" /> Ibe</label>
        </span>
      </div>
      <div class="panel__line">
        <span class="dates">
          <input type="date" name="van" required aria-label="Van" />
          –
          <input type="date" name="tot" aria-label="Tot" />
        </span>
        <select name="pijler" aria-label="Pijler">
          <option>Development</option>
          <option>Design</option>
          <option>UX</option>
          <option>Algemeen</option>
        </select>
        <select name="soort" aria-label="Soort">
          <option>Taak</option>
          <option>Overleg</option>
          <option>Deadline</option>
        </select>
        <span class="grow"></span>
        <button type="button" class="quiet-link" data-add-cancel
          >annuleren</button
        >
        <button type="submit" class="btn btn--primary">Toevoegen</button>
      </div>
    </form>

    <p class="planner-status" data-status>Laden…</p>
    <div class="planner-card" data-timeline></div>
    <div data-list></div>

    <div class="legends">
      <ul class="legend" aria-label="Status">
        <li class="legend-title">Status</li>
        <li><span class="swatch status-todo"></span>Te doen</li>
        <li><span class="swatch status-busy"></span>Bezig</li>
        <li><span class="swatch status-done"></span>Klaar</li>
      </ul>
      <ul class="legend" aria-label="Soort">
        <li class="legend-title">Soort</li>
        <li><Icon name="lucide:code-xml" />Development</li>
        <li><Icon name="lucide:palette" />Design</li>
        <li><Icon name="lucide:layout-template" />UX</li>
        <li><Icon name="lucide:pin" />Algemeen</li>
        <li><Icon name="lucide:flag" />Deadline</li>
        <li><Icon name="lucide:message-circle" />Overleg</li>
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { createClient } from "@supabase/supabase-js";
  import { SUPABASE } from "@config";
  import { bapWeek, weekRange } from "@utils/pijlers";

  type Item = {
    id: string;
    taak: string;
    soort: string;
    pijler: string;
    wie: string[];
    van: string;
    tot: string;
    status: string;
    notitie: string;
    // Link to the blog post about this task (optional).
    post: string | null;
    // Priority: 1 to 3 stars, 3 is the most important. Empty = no priority.
    prio?: number | null;
  };

  const db = createClient(SUPABASE.url, SUPABASE.key);
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const timelineEl = $("[data-timeline]");
  const listEl = $("[data-list]");
  const statusEl = $("[data-status]");
  const rangeEl = $<HTMLButtonElement>("[data-range]");
  const codeForm = $<HTMLFormElement>("[data-code-form]");
  const addForm = $<HTMLFormElement>("[data-add]");
  const editButton = $<HTMLButtonElement>("[data-edit]");
  const newButton = $<HTMLButtonElement>("[data-new]");

  const PEOPLE = ["Senne", "Tjorven", "Ibe"];
  // Emoji instead of colours: what kind of work it is.
  const ICONS: Record<string, string> = JSON.parse(
    $("[data-icons]").dataset.icons ?? "{}"
  );
  const kindOf = (item: Item) =>
    item.soort === "Deadline"
      ? "Deadline"
      : item.soort === "Overleg"
        ? "Overleg"
        : item.pijler;
  const svg = (kind: string) =>
    `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[kind] ?? ICONS.Algemeen}</svg>`;
  // Link to the blog post of a task; a click on it does not open the task.
  const postLink = (href: string, cls: string) => {
    const a = document.createElement("a");
    a.href = href;
    a.className = cls;
    a.innerHTML = `${svg("link")} Blogpost`;
    a.addEventListener("click", e => e.stopPropagation());
    return a;
  };
  const icon = (kind: string) => {
    const node = document.createElement("span");
    node.className = "ico";
    node.innerHTML = svg(kind);
    return node;
  };
  // Priority as filled stars (1 to 3); nothing when a task has no priority.
  const stars = (prio?: number | null) => {
    const node = document.createElement("span");
    node.className = "prio";
    const n = Math.min(3, Math.max(0, prio ?? 0));
    node.setAttribute("aria-label", `Prioriteit ${n} van 3`);
    node.innerHTML = svg("star").repeat(n);
    return node;
  };
  // Status as a pattern: empty = to do, stripes = busy, filled = done.
  const statusClass = (status: string) =>
    status === "Klaar"
      ? "status-done"
      : status === "Bezig"
        ? "status-busy"
        : "status-todo";
  const DAY = 24 * 60 * 60 * 1000;
  // Zoom: 7 days (wide, every title fits) or 21 days (three weeks).
  let DAYS = 21;

  // ---- small helpers
  const store = {
    get: (key: string) => {
      try {
        return localStorage.getItem(key) ?? "";
      } catch {
        return "";
      }
    },
    set: (key: string, value: string) => {
      try {
        value ? localStorage.setItem(key, value) : localStorage.removeItem(key);
      } catch {}
    },
  };
  function store_zoom() {
    return store.get("planning-zoom") === "7" ? 7 : 21;
  }
  const el = (tag: string, cls = "", text = "") => {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text) node.textContent = text;
    return node;
  };
  const button = (cls: string, text: string, onClick: () => void) => {
    const node = el("button", cls, text) as HTMLButtonElement;
    node.type = "button";
    node.addEventListener("click", onClick);
    return node;
  };
  const noon = (iso: string) => new Date(`${iso}T12:00:00Z`);
  const iso = (time: number) => new Date(time).toISOString().slice(0, 10);
  const short = (date: string, options: Intl.DateTimeFormatOptions = {}) =>
    noon(date).toLocaleDateString("nl-BE", {
      timeZone: "UTC",
      day: "numeric",
      month: "short",
      ...options,
    });
  const today = (() => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  })();
  const mondayOf = (date: string) =>
    noon(date).getTime() - ((noon(date).getUTCDay() + 6) % 7) * DAY;
  // A task for all three (or for nobody in particular) goes in the row "Iedereen".
  const forAll = (item: Item) => item.wie.length === 0 || item.wie.length === 3;

  // ---- state
  let items: Item[] = [];
  let code = store.get("planning-code");
  let editing = false;
  let changing: string | null = null;
  let view = store.get("planning-view") === "lijst" ? "lijst" : "tijdlijn";
  let start = mondayOf(today);
  DAYS = store_zoom();

  // ---- data
  async function load() {
    const { data, error } = await db.from("planning").select("*").order("van");
    if (error) {
      // Keep showing the saved copy if there is one.
      if (items.length) return;
      statusEl.hidden = false;
      statusEl.textContent = "De planning kon niet geladen worden.";
      return;
    }
    items = data as Item[];
    store.set(CACHE, JSON.stringify(items));
    render();
  }

  // Last known planning: saved in this browser (also by every other page of
  // the blog, see Layout.astro), or else the snapshot from the build.
  const CACHE = "planning-cache";
  function saved(): Item[] {
    for (const text of [
      store.get(CACHE),
      $("[data-snapshot]").dataset.snapshot ?? "",
    ]) {
      try {
        const list = JSON.parse(text);
        if (Array.isArray(list) && list.length) return list;
      } catch {}
    }
    return [];
  }

  function failed(message: string) {
    if (/code klopt niet/.test(message)) {
      store.set("planning-code", "");
      code = "";
      setEditing(false);
      codeForm.hidden = false;
      $("[data-code-error]").textContent = "Code klopt niet.";
    } else {
      statusEl.hidden = false;
      statusEl.textContent = `Niet bewaard: ${message}`;
    }
  }

  async function save(rij: Partial<Item>) {
    const { error } = await db.rpc("planning_bewaar", { code, rij });
    if (error) return failed(error.message);
    await load();
  }

  async function removeItem(id: string) {
    const { error } = await db.rpc("planning_verwijder", { code, id });
    if (error) return failed(error.message);
    await load();
  }

  // ---- editing one task (under its row, in both views)
  const field = (type: string, value: string, cls = "") => {
    const input = document.createElement("input");
    input.type = type;
    input.value = value;
    if (cls) input.className = cls;
    return input;
  };
  const choice = (options: string[], value: string, label: string) => {
    const select = document.createElement("select");
    select.setAttribute("aria-label", label);
    for (const option of options)
      select.append(new Option(option, option, false, option === value));
    return select;
  };

  function editor(item: Item) {
    const box = el("div", "panel panel--inline");
    const taak = field("text", item.taak, "grow");
    const who = el("span", "who");
    const boxes = PEOPLE.map(name => {
      const label = el("label");
      const check = field("checkbox", name);
      check.checked = item.wie.includes(name);
      label.append(check, ` ${name}`);
      who.append(label);
      return check;
    });
    const van = field("date", item.van);
    const tot = field("date", item.tot);
    const dates = el("span", "dates");
    dates.append(van, " – ", tot);
    const status = choice(["Te doen", "Bezig", "Klaar"], item.status, "Status");
    const prio = document.createElement("select");
    prio.setAttribute("aria-label", "Prioriteit");
    for (const [value, text] of [
      ["", "Geen prio"],
      ["1", "★"],
      ["2", "★★"],
      ["3", "★★★"],
    ])
      prio.append(
        new Option(text, value, false, value === String(item.prio ?? ""))
      );

    const pijler = choice(
      ["Development", "Design", "UX", "Algemeen"],
      item.pijler,
      "Pijler"
    );
    const soort = choice(["Taak", "Overleg", "Deadline"], item.soort, "Soort");
    const notitie = field("text", item.notitie, "grow");
    notitie.placeholder = "Notitie";
    const post = field("url", item.post ?? "", "grow");
    post.placeholder = "Link naar blogpost";
    const more = el("details", "more");
    const moreBody = el("div", "panel__line");
    moreBody.append(
      pijler,
      soort,
      notitie,
      post,
      button("quiet-link danger", "taak verwijderen", () => {
        changing = null;
        removeItem(item.id);
      })
    );
    more.append(el("summary", "", "meer"), moreBody);

    const line1 = el("div", "panel__line");
    line1.append(taak, who);
    const line2 = el("div", "panel__line");
    line2.append(
      dates,
      status,
      prio,
      more,
      button("quiet-link", "annuleren", () => {
        changing = null;
        render();
      }),
      button("btn btn--primary", "Bewaren", () => {
        changing = null;
        save({
          id: item.id,
          taak: taak.value.trim() || item.taak,
          wie: boxes.filter(c => c.checked).map(c => c.value),
          van: van.value || item.van,
          tot: tot.value || van.value || item.tot,
          status: status.value,
          prio: prio.value ? Number(prio.value) : null,
          pijler: pijler.value,
          soort: soort.value,
          notitie: notitie.value.trim(),
          post: post.value.trim(),
        });
      })
    );
    box.append(line1, line2);
    setTimeout(() => taak.focus());
    return box;
  }

  // Clicking a task: ask for the code first if needed, then open it.
  function open(item: Item) {
    if (!code) {
      codeForm.hidden = false;
      return;
    }
    if (!editing) setEditing(true);
    changing = item.id;
    render();
  }

  // ---- views
  function render() {
    const timeline = view === "tijdlijn";
    timelineEl.hidden = !timeline;
    listEl.hidden = timeline;
    $("[data-weeks-nav]").style.visibility = timeline ? "visible" : "hidden";
    $("[data-zoom-switch]").style.visibility = timeline ? "visible" : "hidden";
    document
      .querySelectorAll<HTMLButtonElement>("[data-zoom]")
      .forEach(b =>
        b.setAttribute("aria-pressed", String(Number(b.dataset.zoom) === DAYS))
      );
    document
      .querySelectorAll<HTMLButtonElement>("[data-view]")
      .forEach(b =>
        b.setAttribute("aria-pressed", String(b.dataset.view === view))
      );
    statusEl.hidden = true;
    if (timeline) renderTimeline();
    else renderList();
  }

  // ---- popover for short bars (shown instantly, no native tooltip)
  let pop: HTMLDivElement | null = null;
  let popFor: HTMLElement | null = null;
  // Leaving a bar closes its popover a moment later, so you can still reach its link.
  let popTimer = 0;
  function hidePopSoon() {
    clearTimeout(popTimer);
    popTimer = window.setTimeout(hidePop, 200);
  }
  function hidePop() {
    clearTimeout(popTimer);
    if (pop) pop.hidden = true;
    popFor?.classList.remove("tl-bar--hover");
    popFor = null;
  }
  function showPop(bar: HTMLElement, item: Item) {
    if (!pop) {
      pop = document.createElement("div");
      pop.className = "tl-pop";
      pop.setAttribute("role", "tooltip");
      document.body.append(pop);
      pop.addEventListener("pointerenter", () => clearTimeout(popTimer));
      pop.addEventListener("pointerleave", hidePopSoon);
      // Touch: tap elsewhere closes it.
      document.addEventListener("pointerdown", e => {
        if (popFor && !popFor.contains(e.target as Node)) hidePop();
      });
    }
    const kind = kindOf(item);
    const row = (...parts: (Node | string)[]) => {
      const r = el("div", "tl-pop-row");
      r.append(...parts);
      return r;
    };
    const status = el("span", `swatch ${statusClass(item.status)}`);
    pop.replaceChildren(
      row(icon(kind), el("strong", "", item.taak)),
      el(
        "div",
        "tl-pop-meta",
        `${short(item.van)}${item.tot !== item.van ? ` – ${short(item.tot)}` : ""}`
      ),
      row(
        el("span", "tl-pop-key", "Soort"),
        item.soort === "Taak" ? item.pijler : item.soort
      ),
      row(el("span", "tl-pop-key", "Status"), status, item.status),
      ...(item.prio
        ? [row(el("span", "tl-pop-key", "Prio"), stars(item.prio))]
        : []),
      ...(item.notitie ? [el("div", "tl-pop-note", item.notitie)] : []),
      ...(item.post ? [postLink(item.post, "tl-pop-post")] : [])
    );
    pop.hidden = false;
    popFor?.classList.remove("tl-bar--hover");
    popFor = bar;
    bar.classList.add("tl-bar--hover");
    // Above the bar, clamped to the viewport; below when there is no room.
    const r = bar.getBoundingClientRect();
    const w = pop.offsetWidth;
    const h = pop.offsetHeight;
    const left = Math.min(
      Math.max(8, r.left + r.width / 2 - w / 2),
      window.innerWidth - w - 8
    );
    const above =
      r.bottom + h + 10 > window.innerHeight - 8 && r.top - h - 10 >= 8;
    const top = above ? r.top - h - 10 : r.bottom + 10;
    pop.dataset.side = above ? "above" : "below";
    pop.style.setProperty("--arrow", `${r.left + r.width / 2 - left}px`);
    pop.style.left = `${left}px`;
    pop.style.top = `${top}px`;
  }

  function renderTimeline() {
    hidePop();
    const days = Array.from({ length: DAYS }, (_, i) => iso(start + i * DAY));
    const first = days[0];
    const last = days[DAYS - 1];
    const col = (date: string) =>
      Math.round((noon(date).getTime() - noon(first).getTime()) / DAY);
    rangeEl.textContent =
      DAYS === 7
        ? `Week ${bapWeek(noon(first))}`
        : `Week ${bapWeek(noon(first))} – ${bapWeek(noon(last))}`;
    // Width of one day in pixels, to know how many days a label needs.
    const dayWidth = Math.max(36, (timelineEl.clientWidth - 144) / DAYS);
    // Rough width of a title in pixels (0.8rem bold).
    const textWidth = (item: Item) =>
      item.taak.length * 6.6 + 44 + (item.prio ?? 0) * 13;

    const grid = el("div", "tl");
    grid.style.setProperty("--days", String(DAYS));

    // Header: a week band on top (spans its days), then letter + number per day.
    const corner = el("div", "tl-corner");
    corner.style.gridRow = "2";
    corner.style.gridColumn = "1";
    const cornerTop = el("div", "tl-corner-top");
    cornerTop.style.gridRow = "1";
    cornerTop.style.gridColumn = "1";
    grid.append(cornerTop, corner);
    let weekStart = 0;
    days.forEach((date, i) => {
      const d = noon(date);
      const wk = bapWeek(d);
      const nextWk = i + 1 < DAYS ? bapWeek(noon(days[i + 1])) : -1;
      if (wk !== nextWk) {
        const band = el("div", "tl-weekband", `Week ${wk}`);
        band.style.gridRow = "1";
        band.style.gridColumn = `${weekStart + 2} / ${i + 3}`;
        grid.append(band);
        weekStart = i + 1;
      }
      const cell = el("div", "tl-day");
      cell.style.gridRow = "2";
      cell.style.gridColumn = String(i + 2);
      if (d.getUTCDay() === 1) cell.classList.add("tl-monday");
      if (d.getUTCDay() === 0 || d.getUTCDay() === 6)
        cell.classList.add("tl-weekend");
      if (date === today) cell.classList.add("tl-today");
      cell.append(
        el(
          "span",
          "tl-letter",
          d.toLocaleDateString("nl-BE", { timeZone: "UTC", weekday: "narrow" })
        ),
        el("strong", "", String(d.getUTCDate()))
      );
      grid.append(cell);
    });

    for (const person of [...PEOPLE, "Iedereen"]) {
      const tasks = items
        .filter(item => item.van <= last && item.tot >= first)
        .filter(item =>
          person === "Iedereen"
            ? forAll(item)
            : !forAll(item) && item.wie.includes(person)
        )
        .sort((a, b) => a.van.localeCompare(b.van));

      // Overlapping tasks go on separate lines.
      const lanes: number[] = [];
      const placed = tasks.map(item => {
        const from = Math.max(0, col(item.van));
        const to = Math.min(DAYS - 1, col(item.tot));
        let lane = lanes.findIndex(taken => taken < from);
        if (lane === -1) lane = lanes.length;
        lanes[lane] = to;
        return { item, lane, from, to };
      });

      const name = el("div", "tl-name");
      if (person === "Iedereen") {
        name.append(el("span", "tl-group", ""));
      } else {
        const photo = document.createElement("img");
        photo.src = `${import.meta.env.BASE_URL}team/${person.toLowerCase()}.jpg`;
        photo.alt = "";
        name.append(photo);
      }
      name.append(el("span", "", person));

      const row = el("div", "tl-row");
      row.style.gridTemplateRows = `repeat(${Math.max(1, lanes.length)}, var(--lane))`;
      days.forEach((date, i) => {
        const d = noon(date);
        const bg = el("div", "tl-bg");
        bg.style.gridColumn = String(i + 1);
        if (d.getUTCDay() === 1) bg.classList.add("tl-monday");
        if (d.getUTCDay() === 0 || d.getUTCDay() === 6)
          bg.classList.add("tl-weekend");
        if (date === today) bg.classList.add("tl-today");
        row.append(bg);
      });

      for (const { item, lane, from, to } of placed) {
        // Every task is a bar as long as the task really is, with the name inside.
        // Too narrow for the name: only the icon (zoom to "1 week" to read all names).
        const width = (to - from + 1) * dayWidth - 4;
        const narrow = width < 110 && width < textWidth(item);
        let touch = false;
        const bar = button(
          `tl-bar ${statusClass(item.status)}` +
            (item.soort === "Deadline" ? " tl-bar--deadline" : "") +
            (narrow ? " tl-bar--icon" : "") +
            (item.id === changing ? " tl-bar--open" : ""),
          "",
          () => {
            // Touch: first tap shows the title, second tap opens the task.
            if (touch && popFor !== bar) {
              showPop(bar, item);
              return;
            }
            hidePop();
            open(item);
          }
        );
        bar.append(icon(kindOf(item)));
        if (!narrow) bar.append(el("span", "tl-text", item.taak));
        if (!narrow && item.prio) bar.append(stars(item.prio));
        bar.style.gridColumn = `${from + 1} / ${to + 2}`;
        bar.style.gridRow = String(lane + 1);
        const details = [
          item.taak,
          `${short(item.van)}${item.tot !== item.van ? ` – ${short(item.tot)}` : ""}`,
          `${item.soort === "Taak" ? item.pijler : item.soort} · ${item.status}`,
          item.notitie,
        ].filter(Boolean);
        {
          // Every bar: own instant popover, no native tooltip.
          bar.setAttribute("aria-label", details.join(", "));
          bar.addEventListener(
            "pointerdown",
            e => (touch = e.pointerType === "touch")
          );
          bar.addEventListener("pointerenter", e => {
            if (e.pointerType !== "touch") showPop(bar, item);
          });
          bar.addEventListener("pointerleave", e => {
            if (e.pointerType !== "touch") hidePopSoon();
          });
          bar.addEventListener("focus", () => showPop(bar, item));
          bar.addEventListener("blur", hidePop);
        }
        row.append(bar);
      }
      grid.append(name, row);

      const chosen = placed.find(({ item }) => item.id === changing);
      if (editing && chosen) {
        const panel = editor(chosen.item);
        panel.classList.add("tl-editor");
        grid.append(panel);
      }
    }
    timelineEl.replaceChildren(grid);
  }

  function renderList() {
    const weeks = new Map<number, Item[]>();
    for (const item of items) {
      const week = bapWeek(noon(item.van));
      weeks.set(week, [...(weeks.get(week) ?? []), item]);
    }
    const thisWeek = bapWeek(noon(today));
    const sections = [...weeks]
      .sort(([a], [b]) => a - b)
      .map(([week, list]) => {
        const details = el("details", "list-week") as HTMLDetailsElement;
        details.open = week >= thisWeek || list.some(i => i.id === changing);
        // One clear row per week: arrow (› closed, ⌄ open), week, dates, number of tasks.
        const summary = el("summary");
        summary.append(
          el("span", "list-arrow", ""),
          el("strong", "", `Week ${week}`),
          el("span", "muted", weekRange(week)),
          week === thisWeek ? el("span", "now", "deze week") : "",
          el(
            "span",
            "list-count",
            `${list.length} ${list.length === 1 ? "taak" : "taken"}`
          )
        );
        const card = el("div", "planner-card");
        for (const item of list.sort((a, b) => a.van.localeCompare(b.van))) {
          const row = el(
            "div",
            `list-row${item.status === "Klaar" ? " done" : ""}`
          );
          const what = el("span", "list-what");
          what.append(icon(kindOf(item)), item.taak);
          if (item.prio) what.append(stars(item.prio));
          if (item.post) what.append(postLink(item.post, "list-post"));
          row.append(
            el(
              "span",
              "muted",
              `${short(item.van, { weekday: "short" })}${item.tot !== item.van ? ` – ${short(item.tot)}` : ""}`
            ),
            what,
            el(
              "span",
              "muted",
              forAll(item) ? "Iedereen" : item.wie.join(", ")
            ),
            (() => {
              const cell = el("span", "list-status");
              cell.append(
                el("span", `swatch ${statusClass(item.status)}`),
                item.status
              );
              return cell;
            })()
          );
          row.addEventListener("click", () => open(item));
          card.append(row);
          if (editing && item.id === changing) card.append(editor(item));
        }
        details.append(summary, card);
        return details;
      });
    listEl.replaceChildren(...sections);
  }

  // ---- controls
  function setEditing(on: boolean) {
    editing = on;
    if (!on) changing = null;
    addForm.hidden = true;
    newButton.hidden = !on;
    editButton.replaceChildren(
      icon(on ? "check" : "pencil"),
      on ? " Klaar" : " Bewerken"
    );
    editButton.classList.toggle("btn--primary", on);
    render();
  }

  editButton.addEventListener("click", () => {
    if (editing) return setEditing(false);
    if (code) return setEditing(true);
    codeForm.hidden = !codeForm.hidden;
  });

  codeForm.addEventListener("submit", event => {
    event.preventDefault();
    code = String(new FormData(codeForm).get("code") ?? "");
    store.set("planning-code", code);
    codeForm.hidden = true;
    $("[data-code-error]").textContent = "";
    setEditing(true);
  });

  newButton.addEventListener("click", () => {
    addForm.hidden = false;
    (addForm.elements.namedItem("taak") as HTMLInputElement).focus();
  });
  $("[data-add-cancel]").addEventListener("click", () => {
    addForm.reset();
    addForm.hidden = true;
  });
  addForm.addEventListener("submit", async event => {
    event.preventDefault();
    const form = new FormData(addForm);
    const van = String(form.get("van"));
    await save({
      taak: String(form.get("taak")),
      wie: form.getAll("wie").map(String),
      van,
      tot: String(form.get("tot") || van),
      pijler: String(form.get("pijler")),
      soort: String(form.get("soort")),
    });
    addForm.reset();
    addForm.hidden = true;
  });

  document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach(b =>
    b.addEventListener("click", () => {
      view = b.dataset.view === "lijst" ? "lijst" : "tijdlijn";
      store.set("planning-view", view);
      render();
    })
  );
  document.querySelectorAll<HTMLButtonElement>("[data-step]").forEach(b =>
    b.addEventListener("click", () => {
      start += Number(b.dataset.step) * DAY;
      render();
    })
  );
  document.querySelectorAll<HTMLButtonElement>("[data-zoom]").forEach(b =>
    b.addEventListener("click", () => {
      DAYS = Number(b.dataset.zoom) === 7 ? 7 : 21;
      store.set("planning-zoom", String(DAYS));
      render();
    })
  );
  rangeEl.addEventListener("click", () => {
    start = mondayOf(today);
    render();
  });

  // Live: a change by a teammate shows up straight away.
  db.channel("planning")
    .on(
      "postgres_changes",
      { event: "*", schema: "public", table: "planning" },
      load
    )
    .subscribe();

  // Show the last known planning at once, then fetch the live one.
  items = saved();
  if (items.length) render();
  load();
</script>

